+		if (!pgpa_add_column_sources(walker, outer_plan,
+									 outer_plan->targetlist,
+									 nlp->paramval->varattno, &relids))
+			walker->inexact_params = bms_add_member(walker->inexact_params,
+													nlp->paramno);
+		walker->param_sources[nlp->paramno] = relids;
+	}
