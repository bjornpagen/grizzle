+/*
+ * Add to *relids the RTIs of the relations that supply column 'attno' of the
+ * targetlist 'tlist', which belongs to 'plan' (it is either the plan's own
+ * targetlist or a scan targetlist of the plan).
+ *
+ * The search does not cross into a subquery: a subquery, even one whose
+ * SubqueryScan was elided, is the relation that supplies its own columns.
+ *
+ * Returns true if the column is simply a column of the relations found. It
+ * returns false if the column is computed somewhere along the way, as the
+ * value of a PlaceHolderVar is; the relations the planner charges such a
+ * value to are those it may be evaluated at, which the final plan doesn't
+ * record, and which can include relations no column of the expression comes
+ * from. In that case *relids is still updated, on a best-effort basis, with
+ * the relations whose columns the expression uses.
+ */
+static bool
+pgpa_add_column_sources(pgpa_plan_walker_context *walker, Plan *plan,
+						List *tlist, AttrNumber attno, Bitmapset **relids)
+{
+	PlannedStmt *pstmt = walker->pstmt;
+	TargetEntry *tle;
+	pgpa_column_sources_context context;
+
+	check_stack_depth();
+
+	/*
+	 * If an elided node stood above this one at our query level, it may tell
+	 * us that this is where a subquery begins. Elided Append and MergeAppend
+	 * nodes over partitions don't, since their children belong to our query
+	 * level, but those over subqueries do.
