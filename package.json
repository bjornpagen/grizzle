{
	"name": "grizzle-workspace",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.21.0",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=26",
			"onFail": "error"
		}
	},
	"imports": {
		"#test/*": "./test/*",
		"#scripts/*": "./scripts/*",
		"#bench/*": "./bench/*",
		"#compiler/*": "./packages/engine/src/*",
		"#adapter/*": "./packages/grizzle/src/adapter/*",
		"#client/*": "./packages/grizzle/src/client/*",
		"#cli/*": "./packages/grizzle/src/cli/*",
		"#http/*": "./packages/grizzle/src/http/*",
		"#index.ts": "./packages/grizzle/src/index.ts",
		"#pg/*": "./packages/pg/src/*",
		"#pg.config.ts": "./pg.config.ts",
		"#oxlint.config.ts": "./oxlint.config.ts",
		"#toolchain.config.ts": "./toolchain.config.ts"
	},
	"scripts": {
		"prepare": "effect-tsgo patch",
		"types": "toolchain-turbo run typecheck --filter=./packages/* --filter=//",
		"check": "toolchain-turbo run typecheck workspace-gate oxlint format dead-code architecture dedupe load runtime-gate benchmark --filter=./packages/* --filter=// --continue=dependencies-successful",
		"release": "scripts/release.sh",
		"kills": "scripts/kills.sh",
		"intake": "scripts/intake.sh",
		"typecheck": "toolchain-typecheck -p tsconfig.json",
		"workspace-gate": "workspace-gate",
		"oxlint": "toolchain-oxlint-root",
		"format": "toolchain-oxfmt --check .",
		"format:write": "toolchain-oxfmt .",
		"dead-code": "toolchain-fallow dead-code",
		"architecture": "toolchain-fallow architecture",
		"dedupe": "pnpm dedupe --check",
		"test": "toolchain-test run test/unit test/types",
		"test:network": "toolchain-test run test/pg test/schedules",
		"test:cli-generator": "toolchain-test run packages/cli-generator/test",
		"test:properties": "toolchain-test run",
		"load": "toolchain-test load",
		"fuzz": "toolchain-test fuzz",
		"mutate": "toolchain-test mutate",
		"bench": "node bench/main.ts",
		"bench:full": "node bench/main.ts full",
		"pg:build": "scripts/pg/build.sh",
		"pg:source": "scripts/pg/source.sh",
		"pg": "toolchain-pg"
	},
	"dependencies": {
		"@effect/platform-node": "catalog:",
		"arkregex": "catalog:",
		"effect": "catalog:",
		"pg": "catalog:"
	},
	"devDependencies": {
		"@aws-sdk/rds-signer": "catalog:",
		"@bjornpagen/devtools": "link:vendor/toolchain/packages/devtools",
		"@bjornpagen/grizzle": "link:packages/grizzle",
		"@bjornpagen/grizzle-openapi": "link:packages/openapi",
		"@bjornpagen/grizzle-text": "link:packages/text",
		"@bjornpagen/testing": "link:vendor/toolchain/packages/testing",
		"@clerk/backend": "catalog:",
		"@effect/language-service": "catalog:",
		"@effect/tsgo": "catalog:",
		"@hyperjump/json-schema": "catalog:",
		"@types/node": "catalog:",
		"@types/pg": "catalog:",
		"fallow": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"tsrs": "catalog:",
		"turbo": "catalog:",
		"typescript": "catalog:"
	}
}
