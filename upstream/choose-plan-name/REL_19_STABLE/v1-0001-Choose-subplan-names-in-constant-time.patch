index 83f8f93b7c..f1600a4a0b 100644
--- a/src/backend/optimizer/plan/planner.c
+++ b/src/backend/optimizer/plan/planner.c
@@ -26,6 +26,7 @@
 #include "catalog/pg_inherits.h"
 #include "catalog/pg_proc.h"
 #include "catalog/pg_type.h"
+#include "common/hashfn_unstable.h"
 #include "executor/executor.h"
 #include "foreign/fdwapi.h"
 #include "jit/jit.h"
@@ -152,6 +153,30 @@ typedef struct
 	int			sublevels_up;
 } preprocess_subquery_phvs_context;
 
+/*
+ * Entry in PlannerGlobal's table of subplan names (see choose_plan_name).
+ * The key is a name that has either been assigned to a subroot or been used
+ * as the prefix of a numbered name, or both.
+ */
+typedef struct SubplanNameEntry
+{
+	const char *name;			/* hash key */
+	char		status;			/* hash status */
+	bool		used;			/* name has been assigned to a subroot */
+	unsigned	next_suffix;	/* name_N is in use for every N < this */
+} SubplanNameEntry;
+
+#define SH_PREFIX		subplan_names
+#define SH_ELEMENT_TYPE	SubplanNameEntry
+#define SH_KEY_TYPE		const char *
+#define SH_KEY			name
+#define SH_HASH_KEY(tb, key)	hash_string(key)
+#define SH_EQUAL(tb, a, b)		(strcmp(a, b) == 0)
+#define SH_SCOPE		static inline
+#define SH_DECLARE
+#define SH_DEFINE
+#include "lib/simplehash.h"
+
 /* Local functions */
 static Node *preprocess_expression(PlannerInfo *root, Node *expr, int kind);
 static void preprocess_qual_conditions(PlannerInfo *root, Node *jtnode);
@@ -9271,62 +9296,72 @@ create_partial_unique_paths(PlannerInfo *root, RelOptInfo *input_rel,
 /*
  * Choose a unique name for some subroot.
  *
- * Modifies glob->subplanNames to track names already used.
+ * If always_number is false and no subroot has been given this name yet, use
+ * it as is.  Otherwise, append the smallest positive integer suffix that
+ * produces a name not yet used.
+ *
+ * glob->subplanNames lists the names already used, and glob->subplanNamesHash
+ * holds them for lookup.  For each name that has been numbered, the hash
+ * table also remembers the suffix to try next: every smaller one was found to
+ * be in use, and names are never given up, so they need not be tried again.
+ * Choosing a name thus takes constant time on average, however many names
+ * have been chosen before it.
  */
 char *
 choose_plan_name(PlannerGlobal *glob, const char *name, bool always_number)
 {
+	SubplanNameEntry *entry;
+	bool		found;
 	unsigned	n;
 
+	if (glob->subplanNamesHash == NULL)
+		glob->subplanNamesHash = subplan_names_create(CurrentMemoryContext, 8,
+													  NULL);
+
+	entry = subplan_names_insert(glob->subplanNamesHash, name, &found);
+	if (!found)
+	{
+		/* the caller's string need not live as long as the table */
+		entry->name = pstrdup(name);
+		entry->used = false;
+		entry->next_suffix = 1;
+	}
+
 	/*
-	 * If a numeric suffix is not required, then search the list of
-	 * previously-assigned names for a match. If none is found, then we can
-	 * use the provided name without modification.
+	 * If a numeric suffix is not required and the name is not in use, then we
+	 * can use the provided name without modification.
 	 */
-	if (!always_number)
+	if (!always_number && !entry->used)
 	{
-		bool		found = false;
+		/* pstrdup here is just to avoid cast-away-const */
+		char	   *chosen_name = pstrdup(name);
 
-		foreach_ptr(char, subplan_name, glob->subplanNames)
-		{
-			if (strcmp(subplan_name, name) == 0)
-			{
-				found = true;
-				break;
-			}
-		}
-
-		if (!found)
-		{
-			/* pstrdup here is just to avoid cast-away-const */
-			char	   *chosen_name = pstrdup(name);
-
-			glob->subplanNames = lappend(glob->subplanNames, chosen_name);
-			return chosen_name;
-		}
+		entry->used = true;
+		glob->subplanNames = lappend(glob->subplanNames, chosen_name);
+		return chosen_name;
 	}
 
 	/*
 	 * If a numeric suffix is required or if the un-suffixed name is already
 	 * in use, then loop until we find a positive integer that produces a
-	 * novel name.
+	 * novel name, starting where the last search for this prefix left off.
 	 */
-	for (n = 1; true; ++n)
+	for (n = entry->next_suffix; true; ++n)
 	{
 		char	   *proposed_name = psprintf("%s_%u", name, n);
-		bool		found = false;
+		SubplanNameEntry *proposed;
 
-		foreach_ptr(char, subplan_name, glob->subplanNames)
-		{
-			if (strcmp(subplan_name, proposed_name) == 0)
-			{
-				found = true;
-				break;
-			}
-		}
-
-		if (!found)
+		proposed = subplan_names_lookup(glob->subplanNamesHash, proposed_name);
+		if (proposed == NULL || !proposed->used)
 		{
+			/* do this first, as inserting may move entry */
+			entry->next_suffix = n + 1;
+
+			proposed = subplan_names_insert(glob->subplanNamesHash,
+											proposed_name, &found);
+			if (!found)
+				proposed->next_suffix = 1;
+			proposed->used = true;
 			glob->subplanNames = lappend(glob->subplanNames, proposed_name);
 			return proposed_name;
 		}
