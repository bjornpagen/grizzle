+CREATE FUNCTION relexpr_swapped() RETURNS bit varying
+  LANGUAGE sql IMMUTABLE RETURN B'01';
+CREATE FUNCTION relexpr_swap(k int2) RETURNS int2 LANGUAGE plpgsql AS $$
+BEGIN
