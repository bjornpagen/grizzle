diff --git a/src/test/isolation/specs/serializable-summarized-conflict-out.spec b/src/test/isolation/specs/serializable-summarized-conflict-out.spec
new file mode 100644
index 0000000..fd97ab9
--- /dev/null
+++ b/src/test/isolation/specs/serializable-summarized-conflict-out.spec
@@ -0,0 +1,77 @@
+# A transaction that reads a version whose creator committed before its
+# snapshot has no rw-conflict out to that creator, even when the creator's
+# SERIALIZABLEXACT has been summarized or carries a summary conflict out.
+#
+# heapam passes CheckForSerializableConflictOut the creator of every
+# RECENTLY_DEAD version the scan cannot see, which is often a transaction that
+# committed long before the reader's snapshot.  "holder" keeps an xid and a
+# serializable snapshot open, so every version deleted meanwhile stays
+# RECENTLY_DEAD, and no finished sxact can be cleaned up; "churner" then fills
+# the sxact pool until the oldest finished ones are summarized, as observed by
+# the summarized SIREAD lock of v1 on m in pg_locks (pid NULL).  Nothing in the
+# writer session runs concurrently with anything it reads.
+#
+# In the first permutation, w1 is summarized; v2 and w3 each read versions w1
+# created, and w3 then deletes a row of a table v2 read.  In the second, s
+# reads versions w1 created and inserts a row that t deletes; u then reads that
+# row's dead version, whose creator s is a committed sxact.  None of these
+# transactions can be part of a dangerous structure, so all of them commit.
+
+setup
+{
+	CREATE TABLE owner (id int PRIMARY KEY, n int NOT NULL);
+	CREATE TABLE m (id int PRIMARY KEY, o int NOT NULL, i int NOT NULL);
+	CREATE TABLE n (id int NOT NULL);
+	CREATE TABLE c (id int NOT NULL);
+	CREATE PROCEDURE summarize_m() LANGUAGE plpgsql AS $$
+	DECLARE
+		k int := 0;
+	BEGIN
+		LOOP
+			INSERT INTO c VALUES (k);
+			COMMIT;
+			k := k + 1;
+			EXIT WHEN k % 100 = 0 AND EXISTS (
+				SELECT FROM pg_locks
+				WHERE mode = 'SIReadLock' AND pid IS NULL
+					AND relation IN ('m'::regclass, 'm_pkey'::regclass));
+			IF k > 1000000 THEN
+				RAISE EXCEPTION 'no sxact was summarized after % transactions', k;
+			END IF;
+		END LOOP;
+	END
+	$$;
+}
+
+teardown
+{
+	DROP TABLE owner, m, n, c;
+	DROP PROCEDURE summarize_m();
+}
+
+session holder
+step h_pin	{ BEGIN ISOLATION LEVEL SERIALIZABLE; SELECT pg_current_xact_id() IS NOT NULL AS pinned; }
+step h_end	{ COMMIT; }
+
+session writer
+setup		{ SET default_transaction_isolation = serializable; }
+step w1		{ INSERT INTO owner VALUES (1, 3); INSERT INTO m VALUES (1, 1, 0), (2, 1, 1), (3, 1, 2); }
+step v1		{ SELECT count(*) FROM m; }
+step w2		{ WITH d AS (DELETE FROM m WHERE id = 1 RETURNING id), u AS (UPDATE m SET i = i - 1 WHERE id > 1 RETURNING id) UPDATE owner SET n = n - 1 WHERE id = 1; }
+step v2		{ SELECT count(*) FROM m; }
+step w3		{ DELETE FROM m WHERE id = 2; }
+step wa		{ DELETE FROM m WHERE id = 1; }
+step s		{ INSERT INTO n VALUES (1); SELECT count(*) FROM m; }
+step t		{ DELETE FROM n; }
+step u		{ SELECT count(*) FROM n; }
+
+session churner
+setup		{ SET default_transaction_isolation = serializable; }
+step churn	{ CALL summarize_m(); }
+
+# w3 reads versions of the summarized w1 and writes what v2 read.
+permutation h_pin w1 v1 churn w2 v2 w3 h_end
+
+# u reads the dead version of s, a committed sxact that read versions of the
+# summarized w1.
+permutation h_pin w1 v1 wa churn s t u h_end
