+--
+-- The point of it all: an IMMUTABLE function in a CHECK runs once, not once
+-- per statement.  The cursor keeps the table open, so that its relcache entry
+-- lasts from one statement to the next even in a build that releases unused
+-- entries at once (RELCACHE_FORCE_RELEASE).
+--
+CREATE FUNCTION relexpr_counted() RETURNS bit varying LANGUAGE plpgsql IMMUTABLE AS $$
+BEGIN
+  PERFORM set_config('regress.relexpr_calls',
+    (current_setting('regress.relexpr_calls')::int + 1)::text, false);
+  RETURN B'11';
+END $$;
+CREATE TABLE relexpr_counted (k int2 NOT NULL,
+  CONSTRAINT relexpr_counted_k CHECK ((substring(relexpr_counted() FROM k + 1 FOR 1) = B'1') IS TRUE));
+SET regress.relexpr_calls = 0;
+BEGIN;
+DECLARE relexpr_open CURSOR FOR SELECT * FROM relexpr_counted;
+DO $$ BEGIN FOR i IN 1..10 LOOP INSERT INTO relexpr_counted VALUES (1); END LOOP; END $$;
+SELECT current_setting('regress.relexpr_calls')::int < 10
+  OR current_setting('debug_discard_caches')::int > 0 AS planned_once;
+COMMIT;
+RESET regress.relexpr_calls;
