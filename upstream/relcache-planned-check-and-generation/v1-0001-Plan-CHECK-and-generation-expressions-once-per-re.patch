+--
+-- Executor state built from planned expressions outlives their invalidation.
+-- Here the statement's inserts keep the expressions planned at its first row,
+-- while its conflicting row, which first needs the UPDATE expressions, plans
+-- them after the function has been replaced.
+--
+CREATE FUNCTION relexpr_swapped() RETURNS bit varying
+  LANGUAGE sql IMMUTABLE RETURN B'01';
+CREATE FUNCTION relexpr_swap(k int2) RETURNS int2 LANGUAGE plpgsql AS $$
+BEGIN
+  CREATE OR REPLACE FUNCTION relexpr_swapped() RETURNS bit varying
+    LANGUAGE sql IMMUTABLE RETURN B'10';
+  RETURN k;
+END $$;
+CREATE TABLE relexpr_live (id int PRIMARY KEY, k int2 NOT NULL,
+  admitted bool GENERATED ALWAYS AS (substring(relexpr_swapped() FROM k + 1 FOR 1) = B'1') STORED);
+INSERT INTO relexpr_live (id, k) VALUES (2, 0);
+INSERT INTO relexpr_live (id, k)
+  SELECT g, CASE WHEN g = 2 THEN relexpr_swap(1::int2) ELSE 1::int2 END
+  FROM generate_series(1, 3) AS g
+  ON CONFLICT (id) DO UPDATE SET k = excluded.k;
+SELECT * FROM relexpr_live ORDER BY id;
+INSERT INTO relexpr_live (id, k) VALUES (4, 1);
+SELECT * FROM relexpr_live ORDER BY id;
