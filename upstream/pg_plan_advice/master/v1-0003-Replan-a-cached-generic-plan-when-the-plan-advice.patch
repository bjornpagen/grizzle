+LOAD 'pg_plan_advice';
+SET max_parallel_workers_per_gather = 0;
+-- A cached generic plan is reused only while the advice that would be
+-- supplied now is the advice it was planned under. We test this with the
+-- queries that ri_triggers.c prepares for a foreign key and keeps for the
+-- life of the backend: deleting a key from cp_tgt checks whether cp_ref
+-- still references it, which cp_ref_pkey answers in one descent.
+CREATE TABLE cp_tgt (pkg int, id int, PRIMARY KEY (pkg, id))
+	WITH (autovacuum_enabled = false);
+CREATE TABLE cp_ref (pkg int NOT NULL, id int NOT NULL, seq int NOT NULL,
+	PRIMARY KEY (pkg, id, seq), FOREIGN KEY (pkg, id) REFERENCES cp_tgt)
+	WITH (autovacuum_enabled = false);
+CREATE INDEX cp_ref_seq_pkg ON cp_ref (seq, pkg);
+INSERT INTO cp_tgt SELECT p, i FROM generate_series(1, 3) p,
+	generate_series(1, 100) i;
+INSERT INTO cp_ref SELECT p, i, s FROM generate_series(1, 3) p,
+	generate_series(1, 100) i, generate_series(1, 20) s;
+INSERT INTO cp_tgt SELECT 2, g FROM generate_series(1001, 1020) g;
+-- Make cp_ref look empty, so that every index path ties and the planner's
+-- own choice for the check is the smaller sibling index.
+SELECT pg_restore_relation_stats('schemaname', 'public', 'relname', 'cp_ref',
+	'relpages', 100, 'reltuples', 0::real);
+ pg_restore_relation_stats 
+---------------------------
+ t
+(1 row)
+
+SELECT pg_restore_relation_stats('schemaname', 'public', 'relname', 'cp_tgt',
+	'relpages', 10, 'reltuples', 0::real);
+ pg_restore_relation_stats 
+---------------------------
+ t
+(1 row)
+
+-- Which of cp_ref's indexes have been scanned since we last looked? Call
+-- pg_stat_force_next_flush() first, in a statement of its own, so that the
+-- cumulative statistics include the scans.
+CREATE TABLE cp_seen (indexrelid regclass PRIMARY KEY, scans bigint);
+INSERT INTO cp_seen SELECT indexrelid, 0 FROM pg_index
+	WHERE indrelid = 'cp_ref'::regclass;
+CREATE FUNCTION cp_ref_indexes_used() RETURNS text LANGUAGE sql
+	BEGIN ATOMIC
+	WITH now AS (
+		SELECT indexrelid, idx_scan FROM pg_stat_user_indexes
+		WHERE relid = 'cp_ref'::regclass),
+	newly AS (
+		UPDATE cp_seen s SET scans = now.idx_scan FROM now
+		WHERE s.indexrelid = now.indexrelid AND now.idx_scan > s.scans
+		RETURNING s.indexrelid)
+	SELECT string_agg(indexrelid::text, ', ' ORDER BY indexrelid::text)
+		FROM newly;
+	END;
+-- Under force_generic_plan, the first check builds the generic plan with no
+-- advice in force. A later transaction's advice must reach it, and once that
+-- transaction ends, its advice must not outlive it.
+SET plan_cache_mode = force_generic_plan;
+BEGIN;
+DELETE FROM cp_tgt WHERE pkg = 2 AND id = 1001;
+COMMIT;
+SELECT pg_stat_force_next_flush();
+ pg_stat_force_next_flush 
+--------------------------
+ 
+(1 row)
+
+SELECT cp_ref_indexes_used();
+ cp_ref_indexes_used 
+---------------------
+ cp_ref_seq_pkg
+(1 row)
+
+BEGIN;
+SET LOCAL pg_plan_advice.advice = 'INDEX_SCAN(x public.cp_ref_pkey)';
+DELETE FROM cp_tgt WHERE pkg = 2 AND id = 1002;
+COMMIT;
+SELECT pg_stat_force_next_flush();
+ pg_stat_force_next_flush 
+--------------------------
+ 
+(1 row)
+
+SELECT cp_ref_indexes_used();
+ cp_ref_indexes_used 
+---------------------
+ cp_ref_pkey
+(1 row)
+
+BEGIN;
+DELETE FROM cp_tgt WHERE pkg = 2 AND id = 1003;
+COMMIT;
+SELECT pg_stat_force_next_flush();
+ pg_stat_force_next_flush 
+--------------------------
+ 
+(1 row)
+
+SELECT cp_ref_indexes_used();
+ cp_ref_indexes_used 
+---------------------
+ cp_ref_seq_pkg
+(1 row)
+
+-- The same in the default mode, after the custom-plan trials have settled on
+-- a generic plan.
+RESET plan_cache_mode;
+DISCARD PLANS;
+BEGIN;
+DELETE FROM cp_tgt WHERE pkg = 2 AND id = 1004;
+DELETE FROM cp_tgt WHERE pkg = 2 AND id = 1005;
+DELETE FROM cp_tgt WHERE pkg = 2 AND id = 1006;
+DELETE FROM cp_tgt WHERE pkg = 2 AND id = 1007;
+DELETE FROM cp_tgt WHERE pkg = 2 AND id = 1008;
+DELETE FROM cp_tgt WHERE pkg = 2 AND id = 1009;
+DELETE FROM cp_tgt WHERE pkg = 2 AND id = 1010;
+COMMIT;
+SELECT pg_stat_force_next_flush();
+ pg_stat_force_next_flush 
+--------------------------
+ 
+(1 row)
+
+SELECT cp_ref_indexes_used();
+ cp_ref_indexes_used 
+---------------------
+ cp_ref_seq_pkg
+(1 row)
+
+BEGIN;
+SET LOCAL pg_plan_advice.advice = 'INDEX_SCAN(x public.cp_ref_pkey)';
+DELETE FROM cp_tgt WHERE pkg = 2 AND id = 1011;
+COMMIT;
+SELECT pg_stat_force_next_flush();
+ pg_stat_force_next_flush 
+--------------------------
+ 
+(1 row)
+
+SELECT cp_ref_indexes_used();
+ cp_ref_indexes_used 
+---------------------
+ cp_ref_pkey
+(1 row)
+
+-- A function whose SET clause supplies advice sets the same string on every
+-- call; that must not cost a replan. With pg_plan_advice.trace_mask, each
+-- planning under the advice reports how it changed the strategy mask, so the
+-- second call's silence shows that it reused the plan.
+CREATE FUNCTION cp_count(int) RETURNS bigint LANGUAGE plpgsql
+	SET pg_plan_advice.advice = 'SEQ_SCAN(r)'
+	AS $$
+	DECLARE n bigint;
+	BEGIN
+		SELECT count(*) INTO n FROM cp_ref r WHERE r.pkg = $1;
+		RETURN n;
+	END $$;
+SET plan_cache_mode = force_generic_plan;
+SET pg_plan_advice.trace_mask = true;
+SELECT cp_count(1);
+WARNING:  strategy mask for RTI 1 changed from 0x5ffff to 0x4cfe1
+ cp_count 
+----------
+     2000
+(1 row)
+
+SELECT cp_count(2);
+ cp_count 
+----------
+     2000
+(1 row)
+
+RESET pg_plan_advice.trace_mask;
+RESET plan_cache_mode;
