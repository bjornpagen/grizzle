  * RelationGetIndexAttrBitmap -- get a bitmap of index attribute numbers
  *
@@ -6545,6 +6831,12 @@ load_relcache_init_file(bool shared)
 		rel->rd_exclprocs = NULL;
 		rel->rd_exclstrats = NULL;
