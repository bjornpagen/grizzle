+/*
+ * Output PARAMETERIZED and UNPARAMETERIZED advice.
+ *
+ * We emit advice for each relation for which the planner had a choice of
+ * parameterization, and which is scanned by itself: PARAMETERIZED, naming the
+ * relations it takes parameters from, if its scan is parameterized, and
+ * UNPARAMETERIZED if not. We emit none for a scan that takes a computed
+ * parameter, such as a PlaceHolderVar's value, since we can't tell which
+ * relations the planner charged it to.
+ */
+static void
+pgpa_output_parameterization(pgpa_output_context *context,
+							 pgpa_plan_walker_context *walker)
+{
+	Bitmapset  *unparameterized = NULL;
+	bool		first = true;
+	int			rti = -1;
+
+	while ((rti = bms_next_member(walker->param_choice_rtis, rti)) >= 0)
+	{
+		Bitmapset  *param_relids;
+
+		if (walker->scan_by_rti[rti - 1] == NULL ||
+			walker->scan_by_rti[rti - 1]->param_inexact ||
+			context->rid_strings[rti - 1] == NULL)
+			continue;
+
+		param_relids = pgpa_walker_scan_param_relids(walker,
+													 context->rt_identifiers,
+													 rti);
+		if (param_relids == NULL)
+		{
+			unparameterized = bms_add_member(unparameterized, rti);
+			continue;
+		}
+
+		if (first)
+		{
+			if (context->buf->len > 0)
+				appendStringInfoChar(context->buf, '\n');
+			appendStringInfoString(context->buf, "PARAMETERIZED(");
+			first = false;
+		}
+		else
+		{
+			pgpa_maybe_linebreak(context->buf, context->wrap_column);
+			appendStringInfoChar(context->buf, ' ');
+		}
+
+		appendStringInfoString(context->buf, context->rid_strings[rti - 1]);
+		pgpa_maybe_linebreak(context->buf, context->wrap_column);
+		appendStringInfoChar(context->buf, ' ');
+		if (bms_membership(param_relids) == BMS_SINGLETON)
+			pgpa_output_relations(context, context->buf, param_relids);
+		else
+		{
+			appendStringInfoChar(context->buf, '(');
+			pgpa_output_relations(context, context->buf, param_relids);
+			appendStringInfoChar(context->buf, ')');
+		}
+	}
+
+	if (!first)
+	{
+		appendStringInfoChar(context->buf, ')');
+		pgpa_maybe_linebreak(context->buf, context->wrap_column);
+	}
+
+	if (unparameterized != NULL)
+	{
+		if (context->buf->len > 0)
+			appendStringInfoChar(context->buf, '\n');
+		appendStringInfoString(context->buf, "UNPARAMETERIZED(");
+		pgpa_output_relations(context, context->buf, unparameterized);
+		appendStringInfoChar(context->buf, ')');
+		pgpa_maybe_linebreak(context->buf, context->wrap_column);
+	}
+}
