+/*
+ * Sum the generations of all advisors into *generation. Returns false if some
+ * advisor has no generation function, in which case the sum means nothing.
+ *
+ * Since every generation never decreases, the sum is unchanged only if every
+ * generation is.
+ */
+static bool
+pgpa_advisor_generation(uint64 *generation)
+{
+	*generation = 0;
+	foreach_ptr(pgpa_advisor, advisor, advisor_list)
+	{
+		if (advisor->generation == NULL)
+			return false;
+		*generation += (*advisor->generation) ();
+	}
+	return true;
 }
 
