+				while (rti >= 0)
+				{
+					*relids = bms_add_member(*relids,
+											 walker->top_parent_rtis[rti - 1]);
+					rti = bms_next_member(elided_relids, rti);
+				}
+				return true;
+			}
+		}
+	}
