{
	"name": "grizzle-workspace",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.16.1",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=26",
			"onFail": "error"
		}
	},
	"imports": {
		"#test/*": "./test/*",
		"#scripts/*": "./scripts/*",
		"#bench/*": "./bench/*",
		"#compiler/*": "./packages/engine/src/*",
		"#adapter/*": "./packages/grizzle/src/adapter/*",
		"#cli/*": "./packages/grizzle/src/cli/*",
		"#index.ts": "./packages/grizzle/src/index.ts"
	},
	"scripts": {
		"build": "node --conditions=grizzle-source scripts/build.ts",
		"prepare": "effect-tsgo patch",
		"check": "turbo run typecheck superlint oxlint fixtures:superlint fixtures:oxlint format dead-code architecture dedupe",
		"typecheck": "effect-tsgo tsrs -b",
		"superlint": "superlint",
		"oxlint": "oxlint test bench scripts oxlint.config.ts",
		"format": "oxfmt --check .",
		"format:write": "oxfmt .",
		"dead-code": "fallow dead-code",
		"architecture": "fallow architecture",
		"dedupe": "pnpm dedupe --check",
		"test": "NODE_OPTIONS=\"$NODE_OPTIONS --disable-proto=delete --disable-sigusr1 --throw-deprecation --pending-deprecation --force-context-aware --no-global-search-paths --unhandled-rejections=strict --no-experimental-websocket --no-experimental-webstorage --no-experimental-global-navigator --no-experimental-sqlite --no-experimental-ffi\" node --conditions=grizzle-source node_modules/vitest/vitest.mjs run",
		"test:network": "NODE_OPTIONS=\"$NODE_OPTIONS --disable-proto=delete --disable-sigusr1 --throw-deprecation --pending-deprecation --force-context-aware --no-global-search-paths --unhandled-rejections=strict --no-experimental-websocket --no-experimental-webstorage --no-experimental-global-navigator --no-experimental-sqlite --no-experimental-ffi\" node --conditions=grizzle-source node_modules/vitest/vitest.mjs run --config vitest.network.config.ts",
		"fuzz": "node packages/testing/scripts/fuzz.ts",
		"mutate": "node --conditions=grizzle-source scripts/dev/mutate/main.ts",
		"plpgsql-coverage": "node --conditions=grizzle-source scripts/dev/plpgsql-coverage.ts",
		"bench": "node --conditions=grizzle-source bench/main.ts",
		"bench:full": "node --conditions=grizzle-source bench/main.ts full",
		"pg:build": "scripts/pg/build.sh",
		"pg:init": "scripts/pg/init.sh",
		"pg:doctor": "scripts/pg/doctor.sh",
		"pg": "scripts/pg/ctl.sh",
		"pg:coverage": "scripts/pg/ctl.sh --coverage"
	},
	"dependencies": {
		"@effect/platform-node": "catalog:",
		"arkregex": "catalog:",
		"effect": "catalog:",
		"pg": "catalog:"
	},
	"devDependencies": {
		"@aws-sdk/rds-signer": "catalog:",
		"@bjornpagen/grizzle": "workspace:*",
		"@clerk/backend": "catalog:",
		"@effect/tsgo": "catalog:",
		"@effect/vitest": "catalog:",
		"@grizzle/devtools": "workspace:*",
		"@grizzle/testing": "workspace:*",
		"@types/node": "catalog:",
		"@types/pg": "catalog:",
		"@vercel/functions": "catalog:",
		"amaro": "catalog:",
		"fallow": "catalog:",
		"lefthook": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"turbo": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"superlint": {
		"exceptions": [
			{
				"rule": "no-module-state",
				"files": [
					"packages/engine/src/query/build/scope.ts",
					"test/pg/serverless/support.ts",
					"packages/testing/src/vitest/coverage.ts",
					"test/support/substrate/shared.ts"
				]
			},
			{
				"rule": "no-spread-argument",
				"files": [
					"packages/grizzle/src/adapter/wire/releasing-pool.ts",
					"test/types/evidence/fixtures/evidence.ts",
					"test/unit/deps/runtime-probe.ts"
				]
			}
		],
		"sqlTextAssertion": {
			"files": [
				"test/"
			],
			"exempt": [
				"test/pg/migrate/",
				"test/pg/migrate-gen/",
				"test/unit/deploy/"
			],
			"texts": [
				{
					"module": "packages/engine/src/sql/ast.ts",
					"alias": "EmittedText"
				}
			],
			"matchers": [
				"assert.match",
				"assert.doesNotMatch",
				"containsText",
				"lacksText"
			],
			"equalities": [
				"assert.equal",
				"assert.notEqual"
			]
		},
		"uncheckedVocabularyLiteral": {
			"files": [
				"test/"
			],
			"vocabularies": [
				{
					"module": "packages/engine/src/core/errors.ts",
					"alias": "CompileReasonTag"
				},
				{
					"module": "packages/engine/src/core/errors.ts",
					"alias": "TransientTag"
				},
				{
					"module": "packages/engine/src/core/errors.ts",
					"alias": "CodecFault"
				},
				{
					"module": "packages/engine/src/core/errors.ts",
					"alias": "CursorFault"
				},
				{
					"module": "test/support/error-tags.ts",
					"alias": "GrizzleErrorTag"
				},
				{
					"module": "packages/engine/src/ir/certificate.ts",
					"alias": "CertificateRule"
				}
			],
			"titled": [
				"describe",
				"layer",
				"it",
				"test",
				"effect",
				"live",
				"each"
			],
			"explanations": [
				"message",
				"why"
			]
		}
	}
}
