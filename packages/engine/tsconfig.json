{
	"extends": ["@grizzle/devtools/tsconfig.base.json", "../../tsconfig.base.json"],
	"compilerOptions": {
		"composite": true,
		"incremental": true,
		"noEmit": false,
		"emitDeclarationOnly": true,
		"declarationMap": true,
		"rootDir": "src",
		"outDir": "types",
		"tsBuildInfoFile": "types/tsconfig.tsbuildinfo",
		"plugins": []
	},
	"include": ["src"]
}
