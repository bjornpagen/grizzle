{
	"name": "@bjornpagen/grizzle",
	"private": true,
	"description": "Declare your tables, rules, permissions and queries in TypeScript, and get PostgreSQL 19 constraints, row-level security, indexes, reviewed SQL migrations and exactly typed queries",
	"license": "0BSD",
	"author": "Bjorn Pagen <11238136+bjornpagen@users.noreply.github.com>",
	"type": "module",
	"engines": {
		"node": ">=26"
	},
	"imports": {
		"#adapter/*": "./src/adapter/*",
		"#cli/*": "./src/cli/*",
		"#compiler/*": "@bjornpagen/grizzle-engine/internal/*"
	},
	"exports": {
		".": "./src/index.ts",
		"./runtime": "./src/runtime.ts",
		"./compile": "./src/compile.ts",
		"./package.json": "./package.json"
	},
	"bin": {
		"grizzle": "./src/cli/main.ts"
	},
	"sideEffects": false,
	"scripts": {
		"typecheck": "effect-tsgo tsrs -b",
		"superlint": "superlint",
		"oxlint": "oxlint"
	},
	"dependencies": {
		"@bjornpagen/grizzle-engine": "workspace:*",
		"@effect/platform-node": "catalog:"
	},
	"devDependencies": {
		"@types/pg": "catalog:",
		"effect": "catalog:",
		"pg": "catalog:"
	},
	"peerDependencies": {
		"@types/pg": "^8.23.1",
		"effect": "^4.1.2",
		"pg": "^8.23.1"
	},
	"peerDependenciesMeta": {
		"@types/pg": {
			"optional": true
		}
	}
}
