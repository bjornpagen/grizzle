# The PostgreSQL build every script, test, and benchmark runs against.
# Repinning (RC, GA) changes only this file.

PG_PIN_TAG=REL_19_RC2
PG_PIN_COMMIT=dffcca2e3c81178c64d4c1f44543a3507d0b7508
PG_PIN_VERSION=19rc2
# The pin's source patches, applied in order to the release: scripts/pg/patches/<file>=<its SHA-256>, space-separated.
# A repin drops every patch its release already includes.
PG_PIN_PATCHES="19rc2-relcache-planned-check-and-generation.patch=f0a07e6e9535c2e7b3f6d486d6bc14ea60316ba93646bf97b6098af9226692ad 19rc2-btree-gist-multibyte-penalty.patch=72a5014a4fa2fb13e292336fd88340edf115e6631051e2f3c314b258d95cd098 19rc2-plpgsql-lineno-binary-search.patch=9bb641f8f9aea8f44888255ee28394df01922dfa766149948106975c7535b080"

PGVECTOR_PIN_TAG=v0.8.7
PGVECTOR_PIN_VERSION=0.8.7

PG_PORT=5433
PG_DEV_ROLE=grizzle_dev
PG_TEMPLATE_DB=grizzle_template

# The source, where patches are written, is the release and one commit per patch in a git repository
# (scripts/pg/source.sh). Everything built from it goes beside the prefix.
GRIZZLE_PG_SRC=$HOME/Documents/postgres
GRIZZLE_PG_PREFIX=$HOME/.local/opt/postgresql/$PG_PIN_VERSION
GRIZZLE_PG_BUILD=$GRIZZLE_PG_PREFIX.build
GRIZZLE_PG_STATE=$HOME/.local/var/grizzle/pg$PG_PIN_VERSION
GRIZZLE_PG_DATA=$GRIZZLE_PG_STATE/data
GRIZZLE_PG_TLS=$GRIZZLE_PG_STATE/tls
GRIZZLE_PG_LOG=$GRIZZLE_PG_STATE/log
GRIZZLE_PG_SOCKET=$GRIZZLE_PG_STATE/socket
GRIZZLE_PG_DEV_PASSWORD_FILE=$GRIZZLE_PG_STATE/$PG_DEV_ROLE.password
