diff --git a/deps/v8/src/regexp/regexp-parser.cc b/deps/v8/src/regexp/regexp-parser.cc
index 2792cd0..26a51a3 100644
--- a/deps/v8/src/regexp/regexp-parser.cc
+++ b/deps/v8/src/regexp/regexp-parser.cc
@@ -3080,8 +3080,11 @@ RegExpTree* RegExpParserImpl<CharT>::ParseCharacterClass(
     if (!ignore_case()) {
       character_class_flags |= RegExpClassRanges::NO_CASE_FOLDING_NEEDED;
     }
-    if (sizeof(CharT) == 1) {
-      // No surrogate pairs.
+    if (!IsUnicodeMode()) {
+      // Outside of unicode mode, a character class always matches exactly
+      // one code unit. In unicode mode, even a one-byte pattern source can
+      // describe supplementary code points (e.g. \u{1F600}, \uD83D\uDE00,
+      // \p{...}, or /iu case closure), which match a surrogate pair.
       character_class_flags |= RegExpClassRanges::IS_CERTAINLY_ONE_CODE_POINT;
     }
     return zone()->template New<RegExpClassRanges>(zone(), ranges,
