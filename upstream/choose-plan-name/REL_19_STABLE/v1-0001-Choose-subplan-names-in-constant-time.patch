@@ -4157,3 +4157,93 @@ WHERE t NOT IN (SELECT id FROM not_null_tab);
 (4 rows)
 
 ROLLBACK;
+--
+-- Subplan names are unique within a statement.  A name used as given (a CTE
+-- name or a FROM-clause alias) is numbered if already taken, and a numbered
+-- name takes the smallest suffix not yet in use, by any kind of name.  Here
+-- the CTE exists_3 and the alias array_3 are taken before those names would
+-- be generated, so they are skipped; the CTEs exists_1 and cte (the second)
+-- come after those names are taken, so they become exists_1_1 and cte_1; and
+-- the CTE "exists" keeps its name, which was only ever a prefix before.
+--
+explain (costs off)
+with exists_3 as materialized (select 1 as x),
+     cte as materialized (select 2 as y)
+select exists(select 1 from exists_3) as e1,
+       exists(with exists_1 as materialized (select 3 as z)
+              select 1 from exists_1) as e2,
+       array(select y from cte) as a1,
+       exists(with "exists" as materialized (select 4 as w)
+              select 1 from "exists") as e4,
+       exists(with cte as materialized (select 5 as v)
+              select 1 from cte) as e5,
+       array(select 6) as a2,
+       s.*
+from (select 7 as u offset 0) as array_3,
+     (select array(select 8) as a3, array(select 9) as a4,
+             exists(select 10) as e6 offset 0) as s;
+          QUERY PLAN           
+-------------------------------
+ Nested Loop
+   CTE exists_3
+     ->  Result
+   CTE cte
+     ->  Result
+   InitPlan exists_1
+     ->  CTE Scan on exists_3
+   InitPlan exists_2
+     ->  CTE Scan on exists_1
+           CTE exists_1_1
+             ->  Result
+   InitPlan array_1
+     ->  CTE Scan on cte
+   InitPlan exists_4
+     ->  CTE Scan on "exists"
+           CTE exists
+             ->  Result
+   InitPlan exists_5
+     ->  CTE Scan on cte cte_1
+           CTE cte_1
+             ->  Result
+   InitPlan array_2
+     ->  Result
+   ->  Result
+   ->  Result
+         InitPlan array_4
+           ->  Result
+         InitPlan array_5
+           ->  Result
+         InitPlan exists_6
+           ->  Result
+(31 rows)
+
+-- many sublinks of the same kinds are named exists_1 to exists_100 and
+-- array_1 to array_100
+create function subplan_names(query text) returns setof text
+language plpgsql as
+$$
+declare
+  ln text;
+begin
+  for ln in execute 'explain (costs off) ' || query loop
+    if ln ~ '^\s*(InitPlan|SubPlan|CTE) ' then
+      return next trim(ln);
+    end if;
+  end loop;
+end;
+$$;
+select count(*) as subplans,
+       count(distinct name) as distinct_names,
+       count(*) filter (where name in
+         (select format('InitPlan %s_%s', kind, i)
+          from unnest(array['exists', 'array']) as kind,
+               generate_series(1, 100) as i)) as expected_names
+from subplan_names((select 'select ' || string_agg(format(
+         'exists(select %s), array(select %s)', i, i), ', ')
+       from generate_series(1, 100) as i)) as name;
+ subplans | distinct_names | expected_names 
+----------+----------------+----------------
+      200 |            200 |            200
+(1 row)
+
+drop function subplan_names(text);
