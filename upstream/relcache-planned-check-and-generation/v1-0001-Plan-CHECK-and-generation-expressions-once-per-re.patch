 }
 
+/*
+ * RelationExprEpochCallback
+ *		Syscache callback: a function, type, operator, namespace or role
+ *		changed, so every entry's planned expressions are stale (see
+ *		relexprepoch)
+ */
+static void
+RelationExprEpochCallback(Datum arg, SysCacheIdentifier cacheid,
+						  uint32 hashvalue)
+{
+	relexprepoch++;
+}
+
+/*
+ * RelationPlannedExprsUsable -- may we use and add to the relation's planned
+ *		expressions?
+ *
+ * If they are stale, we start them over.  Executor state built from the
+ * stale ones may still point into them, so their context lives on as a child
+ * of the new one, until RelationClose finds the relation no longer open.
+ * (Compare the partition descriptor's rd_pdcxt.)  We do that at most once
+ * while the relation stays open: should they go stale again before it is
+ * closed, which takes a nested statement and a change of catalog, user or
+ * search_path meanwhile, we keep nothing more, and the caller plans in its
+ * own memory, as if there were no cache.  Each copy is kept only until the
+ * close, so this bounds what a single statement can pile up.
+ */
+static bool
+RelationPlannedExprsUsable(Relation relation)
+{
+	MemoryContext exprcxt;
+
+	if (relation->rd_exprepoch == relexprepoch &&
+		relation->rd_expruser == GetUserId() &&
+		SearchPathMatchesCurrentEnvironment(relation->rd_exprpath))
+		return true;
+
+	if (relation->rd_exprcxt != NULL &&
+		relation->rd_exprcxt->firstchild != NULL)
+		return false;
+
+	if (!relexprepoch_callbacks_registered)
+	{
+		CacheRegisterSyscacheCallback(PROCOID, RelationExprEpochCallback,
+									  (Datum) 0);
+		CacheRegisterSyscacheCallback(TYPEOID, RelationExprEpochCallback,
+									  (Datum) 0);
+		CacheRegisterSyscacheCallback(OPEROID, RelationExprEpochCallback,
+									  (Datum) 0);
+		CacheRegisterSyscacheCallback(NAMESPACEOID, RelationExprEpochCallback,
+									  (Datum) 0);
+		CacheRegisterSyscacheCallback(AUTHOID, RelationExprEpochCallback,
+									  (Datum) 0);
+		CacheRegisterSyscacheCallback(AUTHMEMROLEMEM, RelationExprEpochCallback,
+									  (Datum) 0);
+		relexprepoch_callbacks_registered = true;
+	}
+
+	exprcxt = AllocSetContextCreate(CacheMemoryContext,
+									"relation planned expressions",
+									ALLOCSET_SMALL_SIZES);
+	MemoryContextCopyAndSetIdentifier(exprcxt,
+									  RelationGetRelationName(relation));
+	if (relation->rd_exprcxt != NULL)
+		MemoryContextSetParent(relation->rd_exprcxt, exprcxt);
+
+	relation->rd_exprcxt = exprcxt;
+	relation->rd_exprepoch = relexprepoch;
+	relation->rd_expruser = GetUserId();
+	relation->rd_exprpath = GetSearchPathMatcher(exprcxt);
+	relation->rd_checkexprs = NULL;
+	relation->rd_genexprs = NULL;
+	relation->rd_genplanned = NULL;
+
+	return true;
+}
+
+/*
+ * RelationGetPlannedCheckExprs -- get the planned CHECK constraint expressions
+ *
+ * The result has one element per element of rd_att->constr->check: that
+ * constraint's expression with virtual generated columns expanded and run
+ * through expression_planner, or NULL if the constraint is not enforced.
+ * Planning calls any IMMUTABLE function whose arguments are constants, and
+ * copies its result into the tree, so we do it once per relcache entry rather
+ * than once per statement.
+ *
+ * Unlike most relcache data, this is handed out without copying, so that the
+ * executor state built from it shares any large constant.  The caller must
+ * not modify it.  It remains valid while the caller has the relation open,
+ * even across an invalidation of the entry.
+ */
+Node	  **
+RelationGetPlannedCheckExprs(Relation relation)
+{
+	TupleConstr *constr = relation->rd_att->constr;
+	int			ncheck = constr->num_check;
+	bool		usable = RelationPlannedExprsUsable(relation);
+	Node	  **result;
+	Node	  **checkexprs;
+	MemoryContext oldcxt;
+
+	if (usable && relation->rd_checkexprs != NULL)
+		return relation->rd_checkexprs;
+
+	/*
+	 * We plan in the caller's context, and copy the result into the relcache
+	 * entry only after successfully completing the work.  An invalidation
+	 * that arrives meanwhile leaves the copy stale, to be rebuilt on next
+	 * use.
+	 */
+	result = palloc0_array(Node *, ncheck);
+	for (int i = 0; i < ncheck; i++)
+	{
+		Node	   *expr;
+
+		/* Skip not enforced constraint */
+		if (!constr->check[i].ccenforced)
+			continue;
+
+		expr = stringToNode(constr->check[i].ccbin);
+		expr = expand_generated_columns_in_expr(expr, relation, 1);
+		result[i] = (Node *) expression_planner((Expr *) expr);
+	}
+
+	if (!usable)
+		return result;
+
+	oldcxt = MemoryContextSwitchTo(relation->rd_exprcxt);
+	checkexprs = palloc_array(Node *, ncheck);
+	for (int i = 0; i < ncheck; i++)
+		checkexprs[i] = copyObject(result[i]);
+	relation->rd_checkexprs = checkexprs;
+	MemoryContextSwitchTo(oldcxt);
+
+	return checkexprs;
+}
+
+/*
+ * RelationGetGenerationExpr -- get a generated column's expression
+ *
+ * This is what build_column_default returns for the column, or NULL if the
+ * column is not generated.  We compute it for every generated column at once,
+ * once per relcache entry.  It is not planned; for that, see
+ * RelationGetPlannedGenerationExpr.  As with RelationGetPlannedCheckExprs,
+ * the result is not a copy.
+ */
+Node *
+RelationGetGenerationExpr(Relation relation, AttrNumber attnum)
+{
+	TupleDesc	tupdesc = RelationGetDescr(relation);
+	int			natts = tupdesc->natts;
+	bool		usable = RelationPlannedExprsUsable(relation);
+	Node	  **result;
+	Node	  **genexprs;
+	MemoryContext oldcxt;
+
+	Assert(attnum > 0 && attnum <= natts);
+
+	if (usable && relation->rd_genexprs != NULL)
+		return relation->rd_genexprs[attnum - 1];
+
+	/* As in RelationGetPlannedCheckExprs, build first, then copy */
+	result = palloc0_array(Node *, natts);
+	for (int i = 0; i < natts; i++)
+	{
+		if (TupleDescAttr(tupdesc, i)->attgenerated)
+			result[i] = build_column_default(relation, i + 1);
+	}
+
+	if (!usable)
+		return result[attnum - 1];
+
+	oldcxt = MemoryContextSwitchTo(relation->rd_exprcxt);
+	genexprs = palloc_array(Node *, natts);
+	for (int i = 0; i < natts; i++)
+		genexprs[i] = copyObject(result[i]);
+	relation->rd_genplanned = palloc0_array(Node *, natts);
+	relation->rd_genexprs = genexprs;
+	MemoryContextSwitchTo(oldcxt);
+
+	return genexprs[attnum - 1];
+}
+
+/*
+ * RelationGetPlannedGenerationExpr -- get a generated column's expression,
+ *		planned
+ *
+ * This is RelationGetGenerationExpr's result run through expression_planner.
+ * Each column is planned on its first request, so that a column the executor
+ * doesn't need is never planned, just as before this was cached.  As with
+ * RelationGetPlannedCheckExprs, the result is not a copy.
+ */
+Node *
+RelationGetPlannedGenerationExpr(Relation relation, AttrNumber attnum)
+{
+	bool		usable = RelationPlannedExprsUsable(relation);
+	Node	   *expr;
+	MemoryContext exprcxt;
+	Node	  **genplanned;
+	Node	   *planned;
+	MemoryContext oldcxt;
+
+	if (usable && relation->rd_genplanned != NULL &&
+		relation->rd_genplanned[attnum - 1] != NULL)
+		return relation->rd_genplanned[attnum - 1];
+
+	/* This leaves rd_genplanned set if usable */
+	expr = RelationGetGenerationExpr(relation, attnum);
+	if (expr == NULL)
+		return NULL;
+
+	/*
+	 * Plan a copy in the caller's context, then keep a copy of the result
+	 * where we found the array: that outlives the caller's use of the
+	 * relation, even if the entry is rebuilt while we plan.
+	 */
+	exprcxt = relation->rd_exprcxt;
+	genplanned = relation->rd_genplanned;
+	planned = (Node *) expression_planner((Expr *) copyObject(expr));
+
+	if (!usable)
+		return planned;
+
+	oldcxt = MemoryContextSwitchTo(exprcxt);
+	genplanned[attnum - 1] = copyObject(planned);
+	MemoryContextSwitchTo(oldcxt);
+
+	return genplanned[attnum - 1];
+}
+
