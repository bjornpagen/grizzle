diff --git a/contrib/pg_plan_advice/pgpa_identifier.c b/contrib/pg_plan_advice/pgpa_identifier.c
index 96107dee..67ac98e9 100644
--- a/contrib/pg_plan_advice/pgpa_identifier.c
+++ b/contrib/pg_plan_advice/pgpa_identifier.c
@@ -25,6 +25,13 @@
  * Identifier-style escaping is applied to the schema and to the relation
  * name separately.
  *
+ * Advice may also qualify an identifier with the relation its alias must
+ * refer to, as in alias_name#occurrence_number:schema.relation/..., so that
+ * one advice string can be applied to many queries without an item meant
+ * for one query's relation landing on another query's relation of the same
+ * alias. The qualifier only narrows what an identifier matches; it plays no
+ * part in making identifiers unique, and we never generate it.
+ *
  * The upshot of all of these rules is that in simple cases, the relation
  * identifier is textually identical to the alias name, making life easier
  * for users. However, even in complex cases, every relation identifier
@@ -87,6 +94,12 @@ pgpa_identifier_string(const pgpa_identifier *rid)
 	if (rid->occurrence > 1)
 		result = psprintf("%s#%d", result, rid->occurrence);
 
+	Assert((rid->relnsp == NULL) == (rid->relname == NULL));
+	if (rid->relname != NULL)
+		result = psprintf("%s:%s.%s", result,
+						  quote_identifier(rid->relnsp),
+						  quote_identifier(rid->relname));
+
 	Assert((rid->partnsp == NULL) == (rid->partrel == NULL));
 	if (rid->partrel != NULL)
 		result = psprintf("%s/%s.%s", result,
@@ -99,6 +112,58 @@ pgpa_identifier_string(const pgpa_identifier *rid)
 	return result;
 }
 
+/*
+ * Does a relation identifier computed from a query match an identifier given
+ * in advice?
+ *
+ * The alias name and occurrence number must be equal; the partition schema,
+ * partition name and plan name must be equal or omitted on both sides; and
+ * if the advice names the relation the alias must refer to, it must.
+ */
+bool
+pgpa_identifier_matches(const pgpa_identifier *rid,
+						const pgpa_identifier *target_rid)
+{
+	if (strcmp(rid->alias_name, target_rid->alias_name) != 0)
+		return false;
+	if (rid->occurrence != target_rid->occurrence)
+		return false;
+
+	/*
+	 * A relation identifier should either include both of partition name and
+	 * partition schema, or neither one.
+	 */
+	Assert((rid->partnsp == NULL) == (rid->partrel == NULL));
+
+	/*
+	 * These fields can be NULL on either side, but NULL only matches another
+	 * NULL.
+	 */
+	if (!strings_equal_or_both_null(rid->partnsp, target_rid->partnsp))
+		return false;
+	if (!strings_equal_or_both_null(rid->partrel, target_rid->partrel))
+		return false;
+	if (!strings_equal_or_both_null(rid->plan_name, target_rid->plan_name))
+		return false;
+
+	/* Check the relation the alias refers to, if the advice names one. */
+	if (target_rid->relname != NULL)
+	{
+		char	   *relname;
+
+		if (!OidIsValid(rid->relid))
+			return false;
+		relname = get_rel_name(rid->relid);
+		if (relname == NULL || strcmp(relname, target_rid->relname) != 0)
+			return false;
+		if (strcmp(get_namespace_name_or_temp(get_rel_namespace(rid->relid)),
+				   target_rid->relnsp) != 0)
+			return false;
+	}
+
+	return true;
+}
+
 /*
  * Compute a relation identifier for a particular RTI.
  *
@@ -193,6 +258,9 @@ pgpa_compute_identifier_by_rti(PlannerInfo *root, Index rti,
 	/* OK, we have all the answers we need. Return them to the caller. */
 	rid->alias_name = top_rte->eref->aliasname;
 	rid->occurrence = occurrence;
+	rid->relnsp = NULL;
+	rid->relname = NULL;
+	rid->relid = top_rte->rtekind == RTE_RELATION ? top_rte->relid : InvalidOid;
 	rid->partnsp = partnsp;
 	rid->partrel = partrel;
 	rid->plan_name = root->plan_name;
@@ -329,6 +397,8 @@ pgpa_create_identifiers_for_planned_stmt(PlannedStmt *pstmt)
 		rid = &result[rti - 1];
 		rid->alias_name = top_rte->eref->aliasname;
 		rid->occurrence = occurrence;
+		rid->relid = top_rte->rtekind == RTE_RELATION ?
+			top_rte->relid : InvalidOid;
 		rid->partnsp = partnsp;
 		rid->partrel = partrel;
 		rid->plan_name = plan_name;
@@ -357,16 +427,8 @@ pgpa_compute_rti_from_identifier(int rtable_length,
 		if (rti_rid->alias_name == NULL)
 			continue;
 
-		/*
-		 * If it matches, return this RTI. The partition schema, partition
-		 * name, and plan name must either match exactly or be omitted on both
-		 * sides.
-		 */
-		if (strcmp(rid->alias_name, rti_rid->alias_name) == 0 &&
-			rid->occurrence == rti_rid->occurrence &&
-			strings_equal_or_both_null(rid->partnsp, rti_rid->partnsp) &&
-			strings_equal_or_both_null(rid->partrel, rti_rid->partrel) &&
-			strings_equal_or_both_null(rid->plan_name, rti_rid->plan_name))
+		/* If it matches, return this RTI. */
+		if (pgpa_identifier_matches(rti_rid, rid))
 		{
