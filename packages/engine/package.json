{
	"name": "@bjornpagen/grizzle-engine",
	"private": true,
	"description": "The compiler behind @bjornpagen/grizzle: turns TypeScript tables, rules, permissions and queries into PostgreSQL 19 SQL",
	"license": "0BSD",
	"author": "Bjorn Pagen <11238136+bjornpagen@users.noreply.github.com>",
	"type": "module",
	"engines": {
		"node": ">=26"
	},
	"imports": {
		"#compiler/*": "./src/*"
	},
	"exports": {
		".": "./src/index.ts",
		"./internal/core/array.ts": "./src/core/array.ts",
		"./internal/live/index.ts": "./src/live/index.ts",
		"./internal/plan/catalog.ts": "./src/plan/catalog.ts",
		"./internal/plan/change.ts": "./src/plan/change.ts",
		"./internal/plan/client.ts": "./src/plan/client.ts",
		"./internal/plan/common.ts": "./src/plan/common.ts",
		"./internal/plan/decode.ts": "./src/plan/decode.ts",
		"./internal/plan/migration.ts": "./src/plan/migration.ts",
		"./internal/plan/read.ts": "./src/plan/read.ts",
		"./internal/plan/runtime.ts": "./src/plan/runtime.ts",
		"./internal/plan/serve.ts": "./src/plan/serve.ts",
		"./internal/public/dynamic.ts": "./src/public/dynamic.ts",
		"./package.json": "./package.json",
		"./core/page": "./src/core/page.ts",
		"./codec/delivery": "./src/codec/delivery.ts",
		"./scalar/regex/inclusion": "./src/scalar/regex/inclusion.ts",
		"./lower/shapes/index": "./src/lower/shapes/index.ts",
		"./core/identity": "./src/core/identity.ts",
		"./core/canonical": "./src/core/canonical.ts",
		"./ir/carriers": "./src/ir/carriers.ts",
		"./scalar/values/fault": "./src/scalar/values/fault.ts",
		"./scalar/lexical": "./src/scalar/lexical.ts",
		"./scalar/compute/cast": "./src/scalar/compute/cast.ts",
		"./core/errors": "./src/core/errors.ts",
		"./write/carriers/carriers": "./src/write/carriers/carriers.ts",
		"./schema/representability": "./src/schema/representability.ts",
		"./scalar/values/decimal": "./src/scalar/values/decimal.ts",
		"./core/wire": "./src/core/wire.ts",
		"./scalar/regex/space": "./src/scalar/regex/space.ts",
		"./types/fields/source": "./src/types/fields/source.ts",
		"./sql/print": "./src/sql/print.ts",
		"./deploy/render/folder": "./src/deploy/render/folder.ts",
		"./schema/own": "./src/schema/own.ts",
		"./physical/ddl/constants": "./src/physical/ddl/constants.ts",
		"./laws/model/model": "./src/laws/model/model.ts",
		"./scalar/values/float": "./src/scalar/values/float.ts",
		"./scalar/regex/ir": "./src/scalar/regex/ir.ts"
	},
	"sideEffects": false,
	"scripts": {
		"typecheck": "toolchain-typecheck -b",
		"typecheck:full": "rm -rf types && toolchain-typecheck -p tsconfig.json",
		"oxlint": "toolchain-oxlint"
	},
	"dependencies": {
		"arkregex": "catalog:"
	},
	"devDependencies": {
		"effect": "catalog:"
	},
	"peerDependencies": {
		"effect": "^4.1.2"
	}
}
