+ * PARAMETERIZED(t s) means that the scan of t takes its parameters from
+ * exactly the relations named by s; UNPARAMETERIZED(t) means that it takes
+ * none. We enforce this by restricting the parameterizations of t's paths
+ * (see pgs_required_outer and pgs_forbidden_outer): the advised one is
+ * required, every other relation at this query level is forbidden, and paths
+ * outside that range are disabled when they are added to the rel. Enforcing
+ * this here, rather than when joins are planned, matters: when an
+ * unparameterized path costs the same as the advised parameterized one,
+ * add_path would otherwise discard the parameterized path before any join is
+ * considered.
+ *
+ * Relations that supply parameters are named by their topmost parents,
+ * because that is how the planner names them: a child's path is
+ * parameterized by the parents of the outer relations until it is
+ * reparameterized during plan creation. Outer joins are never named, and a
+ * parameterization that includes one is neither required nor forbidden.
+ */
+static void
+pgpa_planner_apply_param_advice(PlannerInfo *root, pgpa_planner_info *proot,
+								RelOptInfo *rel,
+								pgpa_trove_entry *scan_entries,
+								Bitmapset *scan_indexes)
+{
+	int			i = -1;
+	bool		found = false;
+	bool		conflict = false;
+	Relids		required = NULL;
+	Bitmapset  *param_indexes = NULL;
+	int			flags;
+
+	while ((i = bms_next_member(scan_indexes, i)) >= 0)
+	{
+		pgpa_trove_entry *my_entry = &scan_entries[i];
+		Relids		my_required = NULL;
+
+		if (my_entry->tag != PGPA_TAG_PARAMETERIZED &&
+			my_entry->tag != PGPA_TAG_UNPARAMETERIZED)
+			continue;
+
+		CHECK_FOR_INTERRUPTS();
+
+		/*
+		 * If the sources can't be resolved, mark the advice inapplicable, and
+		 * don't let it take part in conflict detection.
+		 */
+		if (my_entry->tag == PGPA_TAG_PARAMETERIZED &&
+			!pgpa_planner_resolve_param_source(root, proot, rel,
+											   my_entry->target->param_source,
+											   &my_required))
+		{
+			my_entry->flags |= PGPA_FB_MATCH_PARTIAL | PGPA_FB_MATCH_FULL |
+				PGPA_FB_INAPPLICABLE;
+			continue;
+		}
+
+		if (found && !bms_equal(required, my_required))
+			conflict = true;
+		found = true;
+		required = my_required;
+		param_indexes = bms_add_member(param_indexes, i);
+	}
+
+	/* Mark the advice as matched, and as conflicting if it disagrees. */
+	flags = PGPA_FB_MATCH_PARTIAL | PGPA_FB_MATCH_FULL;
+	if (conflict)
+		flags |= PGPA_FB_CONFLICTING;
+	pgpa_trove_set_flags(scan_entries, param_indexes, flags);
+
+	/* If we have a single answer, enforce it. */
+	if (found && !conflict)
+	{
+		Relids		forbidden = NULL;
+		Index		rtable_length = list_length(root->parse->rtable);
+
+		for (Index rti = 1; rti <= rtable_length; ++rti)
+		{
+			RangeTblEntry *rte = rt_fetch(rti, root->parse->rtable);
+
+			if (rte->rtekind != RTE_JOIN && !bms_is_member(rti, required))
+				forbidden = bms_add_member(forbidden, rti);
+		}
+
+		rel->pgs_required_outer = required;
+		rel->pgs_forbidden_outer = forbidden;
+
+		/* Emit debugging message, if enabled. */
+		if (pg_plan_advice_trace_mask)
+		{
+			if (root->plan_name != NULL)
+				ereport(WARNING,
+						(errmsg("parameterization for RTI %u in subplan \"%s\" restricted to %s",
+								rel->relid, root->plan_name,
+								pgpa_bms_to_cstring(required))));
+			else
+				ereport(WARNING,
+						(errmsg("parameterization for RTI %u restricted to %s",
+								rel->relid, pgpa_bms_to_cstring(required))));
+		}
+	}
+}
+
+/*
+ * Resolve the sources named by PARAMETERIZED advice to RTIs.
+ *
+ * Each source must identify exactly one relation of this query level that a
+ * path can be parameterized by: not an appendrel child, which the planner
+ * represents by its topmost parent, and not the target relation itself.
+ * Returns false if any source fails that test.
+ */
+static bool
+pgpa_planner_resolve_param_source(PlannerInfo *root, pgpa_planner_info *proot,
+								  RelOptInfo *rel, pgpa_advice_target *source,
+								  Relids *relids)
+{
+	List	   *sources;
+	Index		rtable_length = list_length(root->parse->rtable);
+
+	if (source->ttype == PGPA_TARGET_IDENTIFIER)
+		sources = list_make1(source);
+	else
+		sources = source->children;
+
+	*relids = NULL;
+	foreach_ptr(pgpa_advice_target, one_source, sources)
+	{
+		Index		match = 0;
+
+		Assert(one_source->ttype == PGPA_TARGET_IDENTIFIER);
+
+		for (Index rti = 1; rti <= rtable_length; ++rti)
+		{
+			pgpa_identifier *rid;
+
+			rid = pgpa_planner_level_identifier(proot, root, rti);
+			if (rid == NULL || !pgpa_identifier_matches_target(rid, one_source))
+				continue;
+			if (match != 0)
+				return false;	/* not unique */
+			match = rti;
+		}
+
+		if (match == 0 || match == rel->relid ||
+			bms_is_member(match, rel->top_parent_relids))
+			return false;
+
+		*relids = bms_add_member(*relids, match);
+	}
+
+	return true;
+}
+
+/*
+ * Get the relation identifier for a given RTI of this query level, if it
+ * names a relation that a path can be parameterized by. Returns NULL for
+ * joins and for appendrel children.
+ */
+static pgpa_identifier *
+pgpa_planner_level_identifier(pgpa_planner_info *proot, PlannerInfo *root,
+							  Index rti)
+{
+	RangeTblEntry *rte = rt_fetch(rti, root->parse->rtable);
+	pgpa_identifier *rid;
+
+	if (rte->rtekind == RTE_JOIN)
+		return NULL;
+	if (root->append_rel_array != NULL && root->append_rel_array[rti] != NULL)
+		return NULL;
+
+	/* Allocate or extend the array as necessary. */
+	if (proot->level_rid_array_size < rti)
+	{
+		int			new_size = pg_nextpower2_32(Max(rti, 8));
+
+		if (proot->level_rid_array_size == 0)
+			proot->level_rid_array = palloc0_array(pgpa_identifier, new_size);
+		else
+			proot->level_rid_array = repalloc0_array(proot->level_rid_array,
+													 pgpa_identifier,
+													 proot->level_rid_array_size,
+													 new_size);
+		proot->level_rid_array_size = new_size;
+	}
+
+	rid = &proot->level_rid_array[rti - 1];
+	if (rid->alias_name == NULL)
+		pgpa_compute_identifier_by_rti(root, rti, rid);
+
+	return rid;
 }
 
