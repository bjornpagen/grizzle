@@ -314,3 +314,34 @@ EXPLAIN (COSTS OFF) SELECT 1;
    SEQ_SCAN(unparameterized) /* not matched */
 (4 rows)
 
+-- An identifier can name the relation its alias must refer to, which must be
+-- schema-qualified.
+SET pg_plan_advice.advice = 'SEQ_SCAN(x:public.t) INDEX_SCAN(x#2:s.t/s.p@q s.i)';
+EXPLAIN (COSTS OFF) SELECT 1;
+                    QUERY PLAN                     
+---------------------------------------------------
+ Result
+ Supplied Plan Advice:
+   SEQ_SCAN(x:public.t) /* not matched */
+   INDEX_SCAN(x#2:s.t/s.p@q s.i) /* not matched */
+(4 rows)
+
+SET pg_plan_advice.advice = 'JOIN_ORDER(a:"S"."T" {b:s.t c}) PARAMETERIZED(a:s.t b:s.u)';
+EXPLAIN (COSTS OFF) SELECT 1;
+                     QUERY PLAN                      
+-----------------------------------------------------
+ Result
+ Supplied Plan Advice:
+   PARAMETERIZED(a:s.t b:s.u) /* not matched */
+   JOIN_ORDER(a:"S"."T" {b:s.t c}) /* not matched */
+(4 rows)
+
+SET pg_plan_advice.advice = 'SEQ_SCAN(x:t)';
+ERROR:  invalid value for parameter "pg_plan_advice.advice": "SEQ_SCAN(x:t)"
+DETAIL:  Could not parse advice: syntax error at or near ")"
+SET pg_plan_advice.advice = 'SEQ_SCAN(x:)';
+ERROR:  invalid value for parameter "pg_plan_advice.advice": "SEQ_SCAN(x:)"
+DETAIL:  Could not parse advice: syntax error at or near ")"
+SET pg_plan_advice.advice = 'SEQ_SCAN(x/s.p:s.t)';
+ERROR:  invalid value for parameter "pg_plan_advice.advice": "SEQ_SCAN(x/s.p:s.t)"
+DETAIL:  Could not parse advice: syntax error at or near ":"
