 src/backend/optimizer/util/pathnode.c | 95 ++++++++++++++++++++++++++-
 src/backend/optimizer/util/relnode.c  |  5 +-
 src/include/nodes/pathnodes.h         | 17 +++++
 3 files changed, 114 insertions(+), 3 deletions(-)

diff --git a/src/backend/optimizer/util/pathnode.c b/src/backend/optimizer/util/pathnode.c
index 5f28174a..883a3f71 100644
--- a/src/backend/optimizer/util/pathnode.c
+++ b/src/backend/optimizer/util/pathnode.c
@@ -53,12 +53,57 @@ static List *reparameterize_pathlist_by_child(PlannerInfo *root,
 											  RelOptInfo *child_rel);
 static bool pathlist_is_reparameterizable_by_child(List *pathlist,
 												   RelOptInfo *child_rel);
+static inline int parameterization_disabled_nodes(RelOptInfo *rel,
+												  Relids required_outer);
+static Path *reparameterize_path_guts(PlannerInfo *root, Path *path,
+									  Relids required_outer,
+									  double loop_count);
 
 
 /*****************************************************************************
  *		MISC. PATH UTILITIES
  *****************************************************************************/
 
+/*
+ * parameterization_disabled_nodes
+ *	  Does a path with the given parameterization violate the restrictions
+ *	  that rel->pgs_required_outer and rel->pgs_forbidden_outer place on the
+ *	  paths of this rel?  Returns 1 if so (the number of disabled nodes the
+ *	  violation adds to the path) and 0 if not.
+ *
+ * The rel's lateral_relids are exempt from pgs_forbidden_outer: every path of
+ * the rel is parameterized by them, so they are not a choice, and forbidding
+ * them would merely disable every path.
+ *
+ * Extensions use these fields to choose among parameterizations, which is a
+ * decision no pgs_mask bit can express; see the comments for the PGS_*
+ * constants in pathnodes.h.  The check is made in add_path and its siblings,
+ * where every path of a rel arrives, and in reparameterize_path, whose paths
+ * bypass add_path, rather than in the cost functions, so that it also covers
+ * paths that core doesn't cost, such as foreign and custom paths.  A path
+ * disabled this way survives as a last resort, as any disabled path does, so
+ * restricting the parameterization can never cause planner failure; and since
+ * it no longer competes as an enabled path, it cannot cause add_path to
+ * discard an enabled path of the permitted parameterization.
+ */
+static inline int
+parameterization_disabled_nodes(RelOptInfo *rel, Relids required_outer)
+{
+	int			relid = -1;
+
+	if (!bms_is_subset(rel->pgs_required_outer, required_outer))
+		return 1;
+	if (rel->pgs_forbidden_outer == NULL)
+		return 0;
+	while ((relid = bms_next_member(required_outer, relid)) >= 0)
+	{
+		if (bms_is_member(relid, rel->pgs_forbidden_outer) &&
+			!bms_is_member(relid, rel->lateral_relids))
+			return 1;
+	}
+	return 0;
+}
+
 /*
  * compare_path_costs
  *	  Return -1, 0, or +1 according as path1 is cheaper, the same cost,
@@ -405,6 +450,11 @@ set_cheapest(RelOptInfo *parent_rel)
  *    numbers of disabled path nodes; but in practice this tiebreak is almost
  *    always used, since normally no path types are disabled.
  *
+ *	  If parent_rel restricts the parameterization of its paths (see
+ *	  pgs_required_outer and pgs_forbidden_outer), a new_path whose
+ *	  parameterization violates the restriction is counted as one more
+ *	  disabled node before any comparison is made.
+ *
  *	  In addition to possibly adding new_path, we also remove from the rel's
  *    pathlist any old paths that are dominated by new_path --- that is,
  *    new_path is cheaper, at least as well ordered, generates no more rows,
@@ -479,6 +529,10 @@ add_path(RelOptInfo *parent_rel, Path *new_path)
 	 */
 	CHECK_FOR_INTERRUPTS();
 
+	/* A path of a parameterization this rel doesn't permit is disabled. */
+	new_path->disabled_nodes +=
+		parameterization_disabled_nodes(parent_rel, PATH_REQ_OUTER(new_path));
+
 	/* Pretend parameterized paths have no pathkeys, per comment above */
 	new_path_pathkeys = new_path->param_info ? NIL : new_path->pathkeys;
 
@@ -700,6 +754,10 @@ add_path_precheck(RelOptInfo *parent_rel, int disabled_nodes,
 	bool		consider_startup;
 	ListCell   *p1;
 
+	/* Count a disabled parameterization, as add_path will */
+	disabled_nodes += parameterization_disabled_nodes(parent_rel,
+													  required_outer);
+
 	/* Pretend parameterized paths have no pathkeys, per add_path policy */
 	new_path_pathkeys = required_outer ? NIL : pathkeys;
 
@@ -824,6 +882,14 @@ add_partial_path(RelOptInfo *parent_rel, Path *new_path)
 	/* Relation should be OK for parallelism, too. */
 	Assert(parent_rel->consider_parallel);
 
+	/*
+	 * Partial paths are never parameterized, which is disabled if this rel's
+	 * paths must be parameterized by something.
+	 */
+	Assert(PATH_REQ_OUTER(new_path) == NULL);
+	new_path->disabled_nodes +=
+		parameterization_disabled_nodes(parent_rel, NULL);
+
 	/*
 	 * As in add_path, throw out any paths which are dominated by the new
 	 * path, but throw out the new path if some existing path dominates it.
@@ -937,6 +1003,9 @@ add_partial_path_precheck(RelOptInfo *parent_rel, int disabled_nodes,
 	bool		consider_startup = parent_rel->consider_startup;
 	ListCell   *p1;
 
+	/* Count a disabled parameterization, as add_partial_path will */
+	disabled_nodes += parameterization_disabled_nodes(parent_rel, NULL);
+
 	/*
 	 * Our goal here is twofold.  First, we want to find out whether this path
 	 * is clearly inferior to some existing partial path.  If so, we want to
@@ -3957,12 +4026,32 @@ adjust_limit_rows_costs(double *rows,	/* in/out parameter */
  * possibly try to delete them on the grounds of being cost-inferior to the
  * paths they were made from, and we don't want that.  Paths made here are
  * not necessarily of general-purpose usefulness, but they can be useful
- * as members of an append path.
+ * as members of an append path.  Since they bypass add_path(), we apply the
+ * rel's restrictions on parameterization here instead.
  */
 Path *
 reparameterize_path(PlannerInfo *root, Path *path,
 					Relids required_outer,
 					double loop_count)
+{
+	Path	   *newpath;
+
+	newpath = reparameterize_path_guts(root, path, required_outer, loop_count);
+	if (newpath != NULL)
+		newpath->disabled_nodes +=
+			parameterization_disabled_nodes(path->parent,
+											PATH_REQ_OUTER(newpath));
+	return newpath;
+}
+
+/*
+ * reparameterize_path_guts
+ *		Workhorse for reparameterize_path
+ */
+static Path *
+reparameterize_path_guts(PlannerInfo *root, Path *path,
+						 Relids required_outer,
+						 double loop_count)
 {
 	RelOptInfo *rel = path->parent;
 
@@ -3992,6 +4081,10 @@ reparameterize_path(PlannerInfo *root, Path *path,
 				newpath->path.param_info =
 					get_baserel_parampathinfo(root, rel, required_outer);
 				cost_index(newpath, root, loop_count, false);
+
+				/* As in create_index_path, honor a disabled index */
+				if (ipath->indexinfo->disabled)
+					newpath->path.disabled_nodes = 1;
 				return (Path *) newpath;
 			}
 		case T_BitmapHeapScan:
