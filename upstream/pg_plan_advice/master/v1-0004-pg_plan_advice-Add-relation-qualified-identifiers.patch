diff --git a/contrib/pg_plan_advice/README b/contrib/pg_plan_advice/README
index f129874d..6f30c706 100644
--- a/contrib/pg_plan_advice/README
+++ b/contrib/pg_plan_advice/README
@@ -76,6 +76,29 @@ occurrence number. For children of partitioned tables, both the partition
 schema and partition name must be included; in other cases, both are
 omitted. The plan_name is omitted for the top-level PlannerInfo.
 
+These identifiers are unique within a query, but an advice string is not
+applied to one query: pg_plan_advice.advice is in force for every query
+planned in its scope, including queries the user never wrote, such as the
+ones ri_triggers.c runs to check foreign keys, all of which alias their
+table "x". So handwritten advice may also qualify an identifier with the
+relation its alias must refer to:
+
+alias_name#occurrence_number:schema.relation/partition_schema.partition_name@plan_name
+
+The qualified identifier matches exactly what the unqualified one would, if
+the alias refers to the named relation (for a child of a partitioned table,
+the topmost partitioned table, the partition itself being named after the
+slash), and nothing otherwise. The relation must be schema-qualified, as a
+partition must. Because the qualifier only narrows a match, identifiers are
+as unique as before. It isn't needed to make advice reproduce the plan of the
+query it was generated from, so generated advice never includes it.
+
+We considered letting the partition component name any relation an RTE
+scans, rather than adding a component, but under traditional inheritance the
+parent's own rows are scanned by a child RTE with the parent's alias and
+relation, already identified as parent/schema.parent, so that identifier
+would then match both the parent RTE and that child.
+
 Scan Advice
 ===========
 
diff --git a/contrib/pg_plan_advice/expected/qualified.out b/contrib/pg_plan_advice/expected/qualified.out
new file mode 100644
index 00000000..8d3b9c97
--- /dev/null
+++ b/contrib/pg_plan_advice/expected/qualified.out
@@ -0,0 +1,199 @@
+LOAD 'pg_plan_advice';
+SET max_parallel_workers_per_gather = 0;
+-- An advice string is applied to every query planned while it is in force,
+-- and different queries can use the same alias for different tables. An
+-- identifier qualified with the relation its alias must refer to matches only
+-- that relation.
+CREATE TABLE q_a (id int PRIMARY KEY, v int) WITH (autovacuum_enabled = false);
+CREATE TABLE q_b (id int PRIMARY KEY, v int) WITH (autovacuum_enabled = false);
+INSERT INTO q_a SELECT g, g FROM generate_series(1, 1000) g;
+INSERT INTO q_b SELECT g, g FROM generate_series(1, 1000) g;
+VACUUM ANALYZE q_a, q_b;
+-- Unqualified, one item for each table meets both queries; in each query one
+-- of them names an index of the other table, and the two conflict.
+BEGIN;
+SET LOCAL pg_plan_advice.advice = 'INDEX_SCAN(x public.q_a_pkey)
+	SEQ_SCAN(x)';
+EXPLAIN (COSTS OFF) SELECT * FROM q_a x WHERE x.id = 1;
+                         QUERY PLAN                         
+------------------------------------------------------------
+ Index Scan using q_a_pkey on q_a x
+   Index Cond: (id = 1)
+ Supplied Plan Advice:
+   INDEX_SCAN(x public.q_a_pkey) /* matched, conflicting */
+   SEQ_SCAN(x) /* matched, conflicting, failed */
+(5 rows)
+
+EXPLAIN (COSTS OFF) SELECT * FROM q_b x WHERE x.id = 1;
+                             QUERY PLAN                             
+--------------------------------------------------------------------
+ Index Scan using q_b_pkey on q_b x
+   Index Cond: (id = 1)
+ Supplied Plan Advice:
+   INDEX_SCAN(x public.q_a_pkey) /* matched, conflicting, failed */
+   SEQ_SCAN(x) /* matched, conflicting, failed */
+(5 rows)
+
+-- Qualified, each item reaches only its own table.
+SET LOCAL pg_plan_advice.advice = 'INDEX_SCAN(x:public.q_a public.q_a_pkey)
+	SEQ_SCAN(x:public.q_b)';
+EXPLAIN (COSTS OFF) SELECT * FROM q_a x WHERE x.id = 1;
+                        QUERY PLAN                        
+----------------------------------------------------------
+ Index Scan using q_a_pkey on q_a x
+   Index Cond: (id = 1)
+ Supplied Plan Advice:
+   INDEX_SCAN(x:public.q_a public.q_a_pkey) /* matched */
+   SEQ_SCAN(x:public.q_b) /* not matched */
+(5 rows)
+
+EXPLAIN (COSTS OFF) SELECT * FROM q_b x WHERE x.id = 1;
+                          QUERY PLAN                          
+--------------------------------------------------------------
+ Seq Scan on q_b x
+   Filter: (id = 1)
+ Supplied Plan Advice:
+   INDEX_SCAN(x:public.q_a public.q_a_pkey) /* not matched */
+   SEQ_SCAN(x:public.q_b) /* matched */
+(5 rows)
+
+-- The qualifier names the relation the alias refers to, so it doesn't match
+-- a subquery, and for a partition it names the partitioned table.
+SET LOCAL pg_plan_advice.advice = 'SEQ_SCAN(x:public.q_a)';
+EXPLAIN (COSTS OFF) SELECT * FROM (SELECT * FROM q_a OFFSET 0) x;
+                 QUERY PLAN                 
+--------------------------------------------
+ Seq Scan on q_a
+ Supplied Plan Advice:
+   SEQ_SCAN(x:public.q_a) /* not matched */
+(3 rows)
+
+COMMIT;
+CREATE TABLE q_part (id int, v int) PARTITION BY RANGE (id);
+CREATE TABLE q_part_1 PARTITION OF q_part FOR VALUES FROM (0) TO (500)
+	WITH (autovacuum_enabled = false);
+CREATE TABLE q_part_2 PARTITION OF q_part FOR VALUES FROM (500) TO (1001)
+	WITH (autovacuum_enabled = false);
+CREATE INDEX ON q_part (id);
+INSERT INTO q_part SELECT g, g FROM generate_series(1, 1000) g;
+VACUUM ANALYZE q_part;
+BEGIN;
+SET LOCAL pg_plan_advice.advice = 'SEQ_SCAN(x:public.q_part/public.q_part_1)
+	SEQ_SCAN(x:public.q_part_1/public.q_part_2)';
+EXPLAIN (COSTS OFF) SELECT * FROM q_part x WHERE x.id < 10 OR x.id > 990;
+                           QUERY PLAN                            
+-----------------------------------------------------------------
+ Append
+   ->  Seq Scan on q_part_1 x_1
+         Filter: ((id < 10) OR (id > 990))
+   ->  Seq Scan on q_part_2 x_2
+         Filter: ((id < 10) OR (id > 990))
+ Supplied Plan Advice:
+   SEQ_SCAN(x:public.q_part/public.q_part_1) /* matched */
+   SEQ_SCAN(x:public.q_part_1/public.q_part_2) /* not matched */
+(8 rows)
+
+COMMIT;
+-- PostgreSQL's own foreign-key checks alias every table x. Deleting a key
+-- from q_tgt runs a check of q_tgt and a check of q_ref, and with
+-- statistics that say both tables are empty, the planner's own choice for
+-- the q_ref check is the smaller sibling index, which skip-scans.
+CREATE TABLE q_tgt (pkg int, id int, PRIMARY KEY (pkg, id))
+	WITH (autovacuum_enabled = false);
+CREATE INDEX q_tgt_id ON q_tgt (id);
+CREATE TABLE q_ref (pkg int NOT NULL, id int NOT NULL, seq int NOT NULL,
+	PRIMARY KEY (pkg, id, seq), FOREIGN KEY (pkg, id) REFERENCES q_tgt)
+	WITH (autovacuum_enabled = false);
+CREATE INDEX q_ref_seq_pkg ON q_ref (seq, pkg);
+INSERT INTO q_tgt SELECT p, i FROM generate_series(1, 3) p,
+	generate_series(1, 100) i;
+INSERT INTO q_ref SELECT p, i, s FROM generate_series(1, 3) p,
+	generate_series(1, 100) i, generate_series(1, 20) s;
+INSERT INTO q_tgt SELECT 2, g FROM generate_series(1001, 1020) g;
+SELECT pg_restore_relation_stats('schemaname', 'public', 'relname', 'q_ref',
+	'relpages', 100, 'reltuples', 0::real);
+ pg_restore_relation_stats 
+---------------------------
+ t
+(1 row)
+
+SELECT pg_restore_relation_stats('schemaname', 'public', 'relname', 'q_tgt',
+	'relpages', 10, 'reltuples', 0::real);
+ pg_restore_relation_stats 
+---------------------------
+ t
+(1 row)
+
+-- Which of q_ref's indexes have been scanned since we last looked? Call
+-- pg_stat_force_next_flush() first, in a statement of its own.
+CREATE TABLE q_seen (indexrelid regclass PRIMARY KEY, scans bigint);
+INSERT INTO q_seen SELECT indexrelid, 0 FROM pg_index
+	WHERE indrelid = 'q_ref'::regclass;
+CREATE FUNCTION q_ref_indexes_used() RETURNS text LANGUAGE sql
+	BEGIN ATOMIC
+	WITH now AS (
+		SELECT indexrelid, idx_scan FROM pg_stat_user_indexes
+		WHERE relid = 'q_ref'::regclass),
+	newly AS (
+		UPDATE q_seen s SET scans = now.idx_scan FROM now
+		WHERE s.indexrelid = now.indexrelid AND now.idx_scan > s.scans
+		RETURNING s.indexrelid)
+	SELECT string_agg(indexrelid::text, ', ' ORDER BY indexrelid::text)
+		FROM newly;
+	END;
+-- Advice for both checks in one string: unqualified, the two items conflict
+-- in each check, and neither is enforced.
+SET pg_plan_advice.feedback_warnings = true;
+BEGIN;
+SET LOCAL pg_plan_advice.advice = 'INDEX_SCAN(x public.q_ref_pkey)
+	INDEX_SCAN(x public.q_tgt_pkey)';
+DELETE FROM q_tgt WHERE pkg = 2 AND id = 1001;
+WARNING:  supplied plan advice was not enforced
+DETAIL:  advice INDEX_SCAN(x public.q_ref_pkey) feedback is "not matched"
+advice INDEX_SCAN(x public.q_tgt_pkey) feedback is "not matched"
+WARNING:  supplied plan advice was not enforced
+DETAIL:  advice INDEX_SCAN(x public.q_ref_pkey) feedback is "matched, conflicting, failed"
+advice INDEX_SCAN(x public.q_tgt_pkey) feedback is "matched, conflicting, failed"
+WARNING:  supplied plan advice was not enforced
+DETAIL:  advice INDEX_SCAN(x public.q_ref_pkey) feedback is "matched, conflicting, failed"
+advice INDEX_SCAN(x public.q_tgt_pkey) feedback is "matched, conflicting, failed"
+COMMIT;
+SELECT pg_stat_force_next_flush();
+ pg_stat_force_next_flush 
+--------------------------
+ 
+(1 row)
+
+SELECT q_ref_indexes_used();
+ q_ref_indexes_used 
+--------------------
+ q_ref_seq_pkg
+(1 row)
+
+-- Qualified, each item reaches its own check, which reports only that the
+-- other item didn't match it.
+BEGIN;
+SET LOCAL pg_plan_advice.advice = 'INDEX_SCAN(x:public.q_ref public.q_ref_pkey)
+	INDEX_SCAN(x:public.q_tgt public.q_tgt_pkey)';
+DELETE FROM q_tgt WHERE pkg = 2 AND id = 1002;
+WARNING:  supplied plan advice was not enforced
+DETAIL:  advice INDEX_SCAN(x:public.q_ref public.q_ref_pkey) feedback is "not matched"
+advice INDEX_SCAN(x:public.q_tgt public.q_tgt_pkey) feedback is "not matched"
+WARNING:  supplied plan advice was not enforced
+DETAIL:  advice INDEX_SCAN(x:public.q_ref public.q_ref_pkey) feedback is "not matched"
+WARNING:  supplied plan advice was not enforced
+DETAIL:  advice INDEX_SCAN(x:public.q_tgt public.q_tgt_pkey) feedback is "not matched"
+COMMIT;
+SELECT pg_stat_force_next_flush();
+ pg_stat_force_next_flush 
+--------------------------
+ 
+(1 row)
+
+SELECT q_ref_indexes_used();
+ q_ref_indexes_used 
+--------------------
+ q_ref_pkey
+(1 row)
+
+RESET pg_plan_advice.feedback_warnings;
diff --git a/contrib/pg_plan_advice/expected/syntax.out b/contrib/pg_plan_advice/expected/syntax.out
index 9146924b..ac4605b6 100644
