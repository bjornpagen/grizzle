{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"tabWidth": 2,
	"printWidth": 100,
	"semi": false,
	"singleQuote": false,
	"jsxSingleQuote": false,
	"quoteProps": "as-needed",
	"trailingComma": "none",
	"arrowParens": "always",
	"bracketSpacing": true,
	"bracketSameLine": false,
	"embeddedLanguageFormatting": "off",
	"sortPackageJson": false,
	"sortImports": {
		"newlinesBetween": false,
		"partitionByNewline": true
	},
	"ignorePatterns": [
		"test/support/openapi/oas-3.2-schema-2025-09-17.json",
		"pnpm-lock.yaml",
		"*.md",
		"test/pg/cli/.ws-*/**",
		".probe-*/**",
		"upstream/**",
		"vendor/**",
		"packages/cli-generator/src/validate/schemas/*.json",
		"packages/cli-generator/test/fixtures/**",
		"packages/cli-generator/corpus/fixtures/**",
		"packages/cli-generator/corpus/specs/**",
		"packages/cli-generator/corpus/verdicts/**"
	]
}
