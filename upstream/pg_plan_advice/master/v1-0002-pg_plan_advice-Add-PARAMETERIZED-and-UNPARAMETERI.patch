+	if (tlist == plan->targetlist)
+	{
+		for (int n = list_length(pstmt->elidedNodes) - 1; n >= 0; --n)
+		{
+			ElidedNode *elided_node = list_nth(pstmt->elidedNodes, n);
+			Bitmapset  *elided_relids;
+			int			rti;
+
+			if (elided_node->plan_node_id != plan->plan_node_id)
+				continue;
+
+			elided_relids = pgpa_filter_out_join_relids(elided_node->relids,
+														pstmt->rtable);
+			rti = bms_next_member(elided_relids, -1);
+			if (rti < 0)
+				continue;
+
+			if (elided_node->elided_type == T_SubqueryScan ||
+				rt_fetch(rti, pstmt->rtable)->rtekind != RTE_RELATION)
