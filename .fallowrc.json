{
	"$schema": "./node_modules/fallow/schema.json",
	"entry": [
		"test/**/*.child.ts",
		"test/support/programs/**/*.ts",
		"test/support/error-tags.ts",
		"test/unit/deps/runtime-probe.ts",
		"test/support/pg-global-setup.ts",
		"test/types/batch/build.ts",
		"test/types/batch/global-setup.ts",
		"bench/**/main.ts",
		"scripts/dev/mutate/reporter.ts",
		"scripts/dev/mutate/take-coverage.ts",
		"scripts/dev/profile/compile.ts",
		"scripts/dev/profile/read.ts",
		"scripts/gen/allen/main.ts",
		"packages/devtools/src/oxlint/fixtures.config.ts",
		"packages/testing/src/vitest/coverage.ts",
		"packages/testing/src/vitest/mutated-setup.ts",
		"packages/testing/src/witness.fixtures.ts"
	],
	"ignorePatterns": [
		"!packages/engine/src/query/build/**",
		"!test/unit/query/build/**",
		"packages/devtools/src/*/fixtures/**"
	],
	"ignoreDependencies": ["grizzle:config"],
	"resolve": {
		"conditions": ["grizzle-source"]
	},
	"boundaries": {
		"zones": [
			{
				"name": "testing",
				"patterns": ["packages/testing/**"]
			},
			{
				// The one reader of PostgreSQL's output texts (codec/read.ts), which the decode zones alone import.
				"name": "reader",
				"patterns": ["packages/engine/src/codec/read.ts"]
			},
			{
				// The engine's decode sites: a family's read, a write's returned rows and a refusal's witness, and the shell's
				// decode facade. Nothing else reaches the reader.
				"name": "decode",
				"patterns": [
					"packages/engine/src/codec/row.ts",
					"packages/engine/src/plan/decode.ts",
					"packages/engine/src/write/family/decode.ts",
					"packages/engine/src/runtime/write/outcome.ts"
				]
			},
			{
				// What a served login's runtime loads (@bjornpagen/grizzle/runtime): the shell modules the runtime entry reaches,
				// each importing the engine's values through the runtime facade alone, so the entry loads no schema builder, law
				// model, lowering, checker or install code. Their types may come from anywhere.
				"name": "adapter-runtime",
				"patterns": [
					"packages/grizzle/src/adapter/apply/readback.ts",
					"packages/grizzle/src/adapter/apply/run.ts",
					"packages/grizzle/src/adapter/connection/config.ts",
					"packages/grizzle/src/adapter/connection/environment.ts",
					"packages/grizzle/src/adapter/db/claims.ts",
					"packages/grizzle/src/adapter/db/context.ts",
					"packages/grizzle/src/adapter/db/handles.ts",
					"packages/grizzle/src/adapter/db/input.ts",
					"packages/grizzle/src/adapter/db/served.ts",
					"packages/grizzle/src/adapter/db/token.ts",
					"packages/grizzle/src/adapter/engine.ts",
					"packages/grizzle/src/adapter/errors/execution.ts",
					"packages/grizzle/src/adapter/errors/failures.ts",
					"packages/grizzle/src/adapter/explain/plan.ts",
					"packages/grizzle/src/adapter/live/**",
					"packages/grizzle/src/adapter/outcomes/index.ts",
					"packages/grizzle/src/adapter/page/window.ts",
					"packages/grizzle/src/adapter/pool/live.ts",
					"packages/grizzle/src/adapter/pool/served.ts",
					"packages/grizzle/src/adapter/public/db.ts",
					"packages/grizzle/src/adapter/public/errors.ts",
					"packages/grizzle/src/adapter/public/layer.ts",
					"packages/grizzle/src/adapter/reader/params.ts",
					"packages/grizzle/src/adapter/reader/relations.ts",
					"packages/grizzle/src/adapter/reader/stream.ts",
					"packages/grizzle/src/adapter/refresh/detail.ts",
					"packages/grizzle/src/adapter/refresh/run.ts",
					"packages/grizzle/src/adapter/served/explain.ts",
					"packages/grizzle/src/adapter/served/load.ts",
					"packages/grizzle/src/adapter/served/served.ts",
					"packages/grizzle/src/adapter/wire/batch.ts",
					"packages/grizzle/src/adapter/wire/failure.ts",
					"packages/grizzle/src/adapter/wire/releasing-pool.ts",
					"packages/grizzle/src/adapter/wire/session.ts",
					"packages/grizzle/src/adapter/witness/classify.ts",
					"packages/grizzle/src/adapter/witness/index.ts",
					"packages/grizzle/src/adapter/witness/keylaw.ts"
				]
			},
			{
				// The shell's decode sites: its readers of a read's and a page's rows, which alone import the decode facade.
				"name": "adapter-decode",
				"patterns": [
					"packages/grizzle/src/adapter/page/execute.ts",
					"packages/grizzle/src/adapter/page/template.ts",
					"packages/grizzle/src/adapter/reader/execution.ts",
					"packages/grizzle/src/adapter/reader/run.ts"
				]
			},
			{
				// What only generate, check and migrate load: drafting and rendering a migration, the installation's DDL and
				// its indexes, the workload's access compile, and their facade (plan/migration.ts). No zone a login's runtime
				// loads imports one, so DbLayer.make and a Db load none of them; plan/serve.ts is the runtime's facade.
				"name": "install",
				"patterns": [
					"packages/engine/src/plan/migration.ts",
					"packages/engine/src/deploy/admission/manifest.ts",
					"packages/engine/src/deploy/diff/**",
					"packages/engine/src/deploy/phases/**",
					"packages/engine/src/deploy/render/**",
					"packages/engine/src/laws/model/restate.ts",
					"packages/engine/src/physical/access/**",
					"packages/engine/src/physical/complete.ts",
					"packages/engine/src/physical/date/storage.ts",
					"packages/engine/src/physical/ddl/advance.ts",
					"packages/engine/src/physical/ddl/literal.ts",
					"packages/engine/src/physical/ddl/rules.ts",
					"packages/engine/src/physical/ddl/tables.ts",
					"packages/engine/src/physical/indexes/**",
					"packages/engine/src/physical/install/comments.ts",
					"packages/engine/src/physical/install/compile.ts",
					"packages/engine/src/physical/refined/constants.ts",
					"packages/engine/src/physical/statistics/**",
					"packages/engine/src/program/workload/compile.ts",
					"packages/engine/src/program/workload/world.ts",
					"packages/engine/src/sql/lexer.ts"
				]
			},
			{
				// The shell's migration, drift and manifest readers, which only generate, check and migrate run, and the one
				// compile of a login's workload, whose served file generate writes and check holds to it.
				"name": "adapter-install",
				"patterns": [
					"packages/grizzle/src/adapter/admission/drift.ts",
					"packages/grizzle/src/adapter/admission/expectation.ts",
					"packages/grizzle/src/adapter/boundary/meta.ts",
					"packages/grizzle/src/adapter/migrate/**",
					"packages/grizzle/src/adapter/public/compile.ts",
					"packages/grizzle/src/adapter/served/compile.ts",
					"packages/grizzle/src/adapter/served/project.ts",
					"packages/grizzle/src/compile.ts"
				]
			},
			{
				// What a served layer and its Dbs run beside the core: the statement helpers a read's and a write's runtime share
				// with the lowering that compiles them. Nothing here loads the compiler.
				"name": "runtime",
				"patterns": ["packages/engine/src/runtime/**"]
			},
			{
				// The core modules a browser loads: none reaches node:crypto (core/sha256.ts, core/seal.ts, and every module over them stays in core), and this zone imports no other, so the client's closure holds no Node module.
				"name": "browser-core",
				"patterns": [
					"packages/engine/src/core/array.ts",
					"packages/engine/src/core/brand.ts",
					"packages/engine/src/core/canonical.ts",
					"packages/engine/src/core/causes.ts",
					"packages/engine/src/core/decimal.ts",
					"packages/engine/src/core/errors.ts",
					"packages/engine/src/core/host.ts",
					"packages/engine/src/core/invariant.ts",
					"packages/engine/src/core/limits.ts",
					"packages/engine/src/core/loc.ts",
					"packages/engine/src/core/nonempty.ts",
					"packages/engine/src/core/order.ts",
					"packages/engine/src/core/record.ts",
					"packages/engine/src/core/result.ts",
					"packages/engine/src/core/text.ts",
					"packages/engine/src/core/trusted.ts",
					"packages/engine/src/core/tuple-map.ts"
				]
			},
			{
				// The value core: the exact values a browser decodes into and builds (Decimal, Money, Vector, Span, uuid, a calendar date) and their carrier limits, over browser-core alone.
				"name": "values",
				"patterns": [
					"packages/engine/src/ir/carriers.ts",
					"packages/engine/src/ir/date.ts",
					"packages/engine/src/ir/decimal.ts",
					"packages/engine/src/scalar/values/decimal.ts",
					"packages/engine/src/scalar/values/fault.ts",
					"packages/engine/src/scalar/values/float.ts",
					"packages/engine/src/scalar/values/money.ts",
					"packages/engine/src/scalar/values/span.ts",
					"packages/engine/src/scalar/values/uuid.ts",
					"packages/engine/src/scalar/values/vector.ts"
				]
			},
			{
				"name": "core",
				"patterns": ["packages/engine/src/core/**"]
			},
			{
				"name": "sql",
				"patterns": ["packages/engine/src/sql/**"]
			},
			{
				"name": "allen",
				"patterns": ["packages/engine/src/allen/**"]
			},
			{
				"name": "ir",
				"patterns": ["packages/engine/src/ir/**"]
			},
			{
				"name": "scalar",
				"patterns": ["packages/engine/src/scalar/**"]
			},
			{
				"name": "logical",
				"patterns": ["packages/engine/src/logical/**"]
			},
			{
				"name": "types",
				"patterns": ["packages/engine/src/types/**"]
			},
			{
				"name": "text",
				"patterns": ["packages/engine/src/text/**"]
			},
			{
				"name": "codec",
				"patterns": ["packages/engine/src/codec/**"]
			},
			{
				"name": "schema",
				"patterns": ["packages/engine/src/schema/**"]
			},
			{
				"name": "check",
				"patterns": ["packages/engine/src/check/**"]
			},
			{
				"name": "analysis",
				"patterns": ["packages/engine/src/analysis/**"]
			},
			{
				"name": "laws",
				"patterns": ["packages/engine/src/laws/**"]
			},
			{
				"name": "query",
				"patterns": ["packages/engine/src/query/**"]
			},
			{
				"name": "lower",
				"patterns": ["packages/engine/src/lower/**"]
			},
			{
				"name": "write",
				"patterns": ["packages/engine/src/write/**"]
			},
			{
				"name": "physical",
				"patterns": ["packages/engine/src/physical/**"]
			},
			{
				"name": "program",
				"patterns": ["packages/engine/src/program/**"]
			},
			{
				"name": "deploy",
				"patterns": ["packages/engine/src/deploy/**"]
			},
			{
				"name": "public",
				"patterns": ["packages/engine/src/public/**"]
			},
			{
				// A login's served workload as data and its file's JSON form, which generate writes and a layer reads.
				"name": "served",
				"patterns": ["packages/engine/src/served/**"]
			},
			{
				// The live event model a browser folds by: events and errors as data, keys, keyed values and their fold, over browser-core alone (LIVE-EVENTS' five modules).
				"name": "live-model",
				"patterns": [
					"packages/engine/src/live/events.ts",
					"packages/engine/src/live/fold.ts",
					"packages/engine/src/live/key.ts",
					"packages/engine/src/live/keyed.ts",
					"packages/engine/src/live/program.ts"
				]
			},
			{
				// The wire's spelling of every served value (live/wire.ts), its regular languages (live/pattern.ts), a served
				// program's wire shape (live/shape.ts) and its codecs (live/codec.ts): runtime-free and browser-safe, the one
				// table the server, the client and the OpenAPI document read.
				"name": "live-wire",
				"patterns": [
					"packages/engine/src/live/wire.ts",
					"packages/engine/src/live/pattern.ts",
					"packages/engine/src/live/shape.ts",
					"packages/engine/src/live/codec.ts"
				]
			},
			{
				// A served member's wire shape read off its served form (live/member.ts), which generate writes into the
				// served file, and the OpenAPI document of a login (live/openapi.ts).
				"name": "live-served",
				"patterns": ["packages/engine/src/live/member.ts", "packages/engine/src/live/openapi.ts"]
			},
			{
				// Liveness's one grammar and plan (live/notify.ts): a write's route keys, their payload text and its parser,
				// which the writer's side prints and the runtime's side reads; it loads no compiler.
				"name": "live",
				"patterns": ["packages/engine/src/live/**"]
			},
			{
				// The engine's client facade: every engine value @bjornpagen/grizzle/client loads, from browser-safe modules alone.
				"name": "plan-client",
				"patterns": ["packages/engine/src/plan/client.ts"]
			},
			{
				// The engine's runtime facade: every engine value the runtime shell loads, each from a module that loads no
				// compiler.
				"name": "plan-runtime",
				"patterns": ["packages/engine/src/plan/runtime.ts"]
			},
			{
				"name": "plan",
				"patterns": ["packages/engine/src/plan/**"]
			},
			{
				"name": "adapter",
				"patterns": ["packages/grizzle/src/adapter/**"]
			},
			{
				"name": "cli",
				"patterns": ["packages/grizzle/src/cli/**"]
			},
			{
				"name": "engine-index",
				"patterns": ["packages/engine/src/index.ts"]
			},
			{
				"name": "runtime-entry",
				"patterns": ["packages/grizzle/src/runtime.ts"]
			},
			{
				// @bjornpagen/grizzle/http: a served login's runtime over HTTP, which loads what a Db does and no more: the
				// runtime shell (a layer's held roles, Db.open's context, a member's calls), the engine's runtime facade and
				// what it re-exports of core, the live model and the wire's codecs; the served forms and the schema's types by
				// type alone.
				"name": "http",
				"patterns": ["packages/grizzle/src/http/**"]
			},
			{
				"name": "index",
				"patterns": ["packages/grizzle/src/index.ts"]
			},
			{
				// @bjornpagen/grizzle/client: the browser client, which loads the engine through its client facade alone.
				"name": "client",
				"patterns": ["packages/grizzle/src/client/**", "packages/grizzle/src/client.ts"]
			}
		],
		"rules": [
			{
				// Browser-safe by construction: no zone here imports one that reaches a Node module.
				"from": "browser-core",
				"allow": [],
				"allowTypeOnly": ["core"]
			},
			{
				"from": "values",
				"allow": ["browser-core"],
				"allowTypeOnly": ["core", "ir", "scalar", "types"]
			},
			{
				"from": "live-model",
				"allow": ["browser-core"],
				"allowTypeOnly": ["core", "live", "live-wire", "types"]
			},
			{
				"from": "plan-client",
				"allow": ["browser-core", "live-model", "live-wire", "values"]
			},
			{
				"from": "client",
				"allow": ["browser-core", "client", "live-model", "live-wire", "plan-client", "values"],
				"allowTypeOnly": [
					"browser-core",
					"core",
					"live",
					"live-model",
					"live-wire",
					"plan",
					"types",
					"values"
				]
			},
			{
				"from": "testing",
				"allow": []
			},
			{
				"from": "reader",
				"allow": ["browser-core", "codec", "core", "ir", "scalar", "values"]
			},
			{
				"from": "decode",
				"allow": [
					"analysis",
					"browser-core",
					"check",
					"codec",
					"core",
					"ir",
					"laws",
					"logical",
					"lower",
					"query",
					"reader",
					"runtime",
					"scalar",
					"schema",
					"sql",
					"types",
					"values",
					"write"
				]
			},
			{
				"from": "install",
				"allow": [
					"analysis",
					"browser-core",
					"check",
					"codec",
					"core",
					"decode",
					"deploy",
					"ir",
					"laws",
					"live",
					"live-model",
					"live-served",
					"live-wire",
					"logical",
					"lower",
					"physical",
					"program",
					"query",
					"scalar",
					"schema",
					"served",
					"sql",
					"text",
					"types",
					"values",
					"write"
				]
			},
			{
				"from": "adapter-install",
				"allow": [
					"adapter",
					"adapter-decode",
					"adapter-runtime",
					"analysis",
					"browser-core",
					"check",
					"codec",
					"core",
					"decode",
					"deploy",
					"install",
					"ir",
					"live-served",
					"logical",
					"lower",
					"physical",
					"plan",
					"program",
					"query",
					"runtime",
					"scalar",
					"schema",
					"served",
					"sql",
					"types",
					"values",
					"write"
				]
			},
			{
				// The runtime names the compiled forms it runs by type alone; its witness decode site is the decode zone's.
				"from": "runtime",
				"allow": ["browser-core", "codec", "core", "decode", "ir", "scalar", "values"],
				"allowTypeOnly": ["laws", "lower", "sql", "types", "write"]
			},
			{
				"from": "core",
				"allow": ["browser-core"]
			},
			{
				"from": "sql",
				"allow": ["browser-core", "core"]
			},
			{
				"from": "allen",
				"allow": ["browser-core", "core", "sql"]
			},
			{
				"from": "ir",
				"allow": ["browser-core", "core", "sql", "values"]
			},
			{
				"from": "scalar",
				"allow": ["browser-core", "core", "ir", "values"]
			},
			{
				"from": "logical",
				"allow": ["browser-core", "core", "ir", "scalar", "values"]
			},
			{
				"from": "types",
				"allow": ["allen", "browser-core", "core", "ir", "scalar", "values"]
			},
			{
				"from": "text",
				"allow": ["browser-core", "core", "ir", "scalar", "sql", "types", "values"]
			},
			{
				"from": "codec",
				"allow": ["browser-core", "core", "ir", "scalar", "types", "values"]
			},
			{
				"from": "schema",
				"allow": [
					"browser-core",
					"codec",
					"core",
					"ir",
					"runtime",
					"scalar",
					"sql",
					"text",
					"types",
					"values"
				]
			},
			{
				"from": "check",
				"allow": [
					"allen",
					"browser-core",
					"core",
					"ir",
					"logical",
					"scalar",
					"schema",
					"text",
					"values"
				]
			},
			{
				"from": "analysis",
				"allow": [
					"browser-core",
					"check",
					"core",
					"ir",
					"logical",
					"runtime",
					"scalar",
					"schema",
					"text",
					"types",
					"values"
				]
			},
			{
				// The law model attaches the described public Law to each constraint it plans: Law is plain data, so naming
				// its type couples nothing at run time.
				"from": "laws",
				"allow": ["analysis", "browser-core", "core", "ir", "scalar", "schema", "sql", "values"],
				"allowTypeOnly": ["types"]
			},
			{
				"from": "query",
				"allow": ["browser-core", "core", "ir", "scalar", "schema", "text", "types", "values"]
			},
			{
				"from": "lower",
				"allow": [
					"analysis",
					"browser-core",
					"check",
					"codec",
					"core",
					"ir",
					"logical",
					"runtime",
					"scalar",
					"sql",
					"values"
				]
			},
			{
				"from": "write",
				"allow": [
					"analysis",
					"browser-core",
					"check",
					"codec",
					"core",
					"decode",
					"ir",
					"laws",
					"logical",
					"lower",
					"query",
					"runtime",
					"scalar",
					"schema",
					"served",
					"sql",
					"types",
					"values"
				]
			},
			{
				"from": "physical",
				"allow": [
					"analysis",
					"browser-core",
					"check",
					"core",
					"ir",
					"laws",
					"live",
					"live-model",
					"logical",
					"lower",
					"runtime",
					"scalar",
					"schema",
					"sql",
					"text",
					"types",
					"values",
					"write"
				],
				"allowTypeOnly": ["install"]
			},
			{
				"from": "program",
				"allow": [
					"analysis",
					"browser-core",
					"check",
					"codec",
					"core",
					"decode",
					"ir",
					"laws",
					"live",
					"live-model",
					"logical",
					"lower",
					"physical",
					"query",
					"runtime",
					"scalar",
					"schema",
					"served",
					"sql",
					"types",
					"values",
					"write"
				]
			},
			{
				"from": "deploy",
				"allow": [
					"browser-core",
					"core",
					"ir",
					"laws",
					"live",
					"live-model",
					"lower",
					"physical",
					"schema",
					"sql",
					"text",
					"values"
				],
				"allowTypeOnly": ["install"]
			},
			{
				"from": "public",
				"allow": [
					"allen",
					"browser-core",
					"core",
					"ir",
					"program",
					"query",
					"scalar",
					"schema",
					"text",
