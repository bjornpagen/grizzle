# The PostgreSQL build every script, test, and benchmark runs against: the official release, unpatched, as hosted
# providers run it. Repinning (a minor release) changes only this file.

PG_PIN_VERSION=19.0
# The release's source is its tarball, PostgreSQL's own `make dist` of the tag, verified by the SHA-256 postgresql.org
# publishes beside it (postgresql-<version>.tar.bz2.sha256). The tag and its commit say what the tarball is made from.
PG_PIN_TARBALL=https://ftp.postgresql.org/pub/source/v$PG_PIN_VERSION/postgresql-$PG_PIN_VERSION.tar.bz2
PG_PIN_SHA256=a89fd70efbad6a08c7dbed8d4872e3af30170d9e5ca9dc7906523be95b4e692d
PG_PIN_TAG=REL_19_0
PG_PIN_COMMIT=5c839a2a08b9b87a349be97371fac6c5a2873b10

PGVECTOR_PIN_TAG=v0.8.7
PGVECTOR_PIN_VERSION=0.8.7

# Everything made for the build goes beside the prefix: the tarball once fetched and verified, the source extracted from
# it, and the build tree (scripts/pg/source.sh).
GRIZZLE_PG_PREFIX=$HOME/.local/opt/postgresql/$PG_PIN_VERSION
GRIZZLE_PG_TARBALL=$GRIZZLE_PG_PREFIX.tar.bz2
GRIZZLE_PG_SRC=$GRIZZLE_PG_PREFIX.src
GRIZZLE_PG_BUILD=$GRIZZLE_PG_PREFIX.build
