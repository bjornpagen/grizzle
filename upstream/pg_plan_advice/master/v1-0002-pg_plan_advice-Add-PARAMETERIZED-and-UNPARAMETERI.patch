+pgpa_column_sources_walker(Node *node, pgpa_column_sources_context *context)
+{
+	if (node == NULL)
+		return false;
+
+	if (IsA(node, Var))
+	{
+		Var		   *var = (Var *) node;
+		Plan	   *plan = context->plan;
+		Plan	   *child = NULL;
+
+		switch (var->varno)
+		{
+			case OUTER_VAR:
+
+				/*
+				 * Append and MergeAppend nodes keep their children elsewhere,
+				 * but every child produces the same columns, and we want only
+				 * topmost parents anyway, so the first child will do.
+				 */
+				if (IsA(plan, Append))
+				{
+					List	   *appendplans = ((Append *) plan)->appendplans;
+
+					child = appendplans == NIL ? NULL : linitial(appendplans);
+				}
+				else if (IsA(plan, MergeAppend))
+				{
+					List	   *mergeplans = ((MergeAppend *) plan)->mergeplans;
+
+					child = mergeplans == NIL ? NULL : linitial(mergeplans);
+				}
+				else
+					child = outerPlan(plan);
+				break;
+			case INNER_VAR:
+				child = innerPlan(plan);
+				break;
+			case INDEX_VAR:
+				if (IsA(plan, IndexOnlyScan))
+					context->relids =
+						bms_add_member(context->relids,
+									   context->walker->top_parent_rtis[((Scan *) plan)->scanrelid - 1]);
+				else if (IsA(plan, ForeignScan))
+					context->exact &=
+						pgpa_add_column_sources(context->walker, plan,
+												((ForeignScan *) plan)->fdw_scan_tlist,
+												var->varattno, &context->relids);
+				else if (IsA(plan, CustomScan))
+					context->exact &=
+						pgpa_add_column_sources(context->walker, plan,
+												((CustomScan *) plan)->custom_scan_tlist,
+												var->varattno, &context->relids);
+				return false;
+			case ROWID_VAR:
+				return false;
+			default:
+				Assert(!IS_SPECIAL_VARNO(var->varno));
+				context->relids =
+					bms_add_member(context->relids,
+								   context->walker->top_parent_rtis[var->varno - 1]);
+				return false;
+		}
+
+		if (child != NULL)
+			context->exact &=
+				pgpa_add_column_sources(context->walker, child,
+										child->targetlist, var->varattno,
+										&context->relids);
+		return false;
+	}
+
+	return expression_tree_walker(node, pgpa_column_sources_walker, context);
+}
+
+/*
+ * After the plan tree walk, work out which relations each scan takes
+ * parameters from, index scans of single relations by RTI, and translate
+ * the planner's record of which relations had a choice of parameterization
+ * into RTIs of the final range table.
+ */
+static void
+pgpa_finish_scan_params(pgpa_plan_walker_context *walker, List *proots)
+{
+	walker->scan_by_rti = palloc0_array(pgpa_scan *,
+										list_length(walker->pstmt->rtable));
+
+	for (int s = 0; s < NUM_PGPA_SCAN_STRATEGY; s++)
+	{
+		foreach_ptr(pgpa_scan, scan, walker->scans[s])
+		{
+			int			paramid = -1;
+			int			rti;
+
+			while ((paramid = bms_next_member(scan->plan->extParam,
+											  paramid)) >= 0)
+			{
+				if (paramid < walker->nparam_sources)
+					scan->param_relids =
+						bms_add_members(scan->param_relids,
+										walker->param_sources[paramid]);
+				if (bms_is_member(paramid, walker->inexact_params))
+					scan->param_inexact = true;
+			}
+
+			if (bms_get_singleton_member(scan->relids, &rti) &&
+				walker->scan_by_rti[rti - 1] == NULL)
+				walker->scan_by_rti[rti - 1] = scan;
+		}
+	}
+
+	foreach_ptr(pgpa_planner_info, proot, proots)
+	{
+		int			rti = -1;
+
+		if (!proot->has_rtoffset)
+			continue;
+		while ((rti = bms_next_member(proot->param_choice_rels, rti)) >= 0)
+			walker->param_choice_rtis =
+				bms_add_member(walker->param_choice_rtis,
+							   rti + proot->rtoffset);
+	}
+}
+
