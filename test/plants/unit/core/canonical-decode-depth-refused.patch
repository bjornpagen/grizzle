+++ b/packages/engine/src/core/canonical.ts
@@ -1380,6 +1380,15 @@ export const decode = (text: string, revivers: Revivers): Result.Result<unknown,
 	if (!parsed.ok) {
 		return Result.err(malformedArtifact("canonical", [], "JSON text"))
 	}
+	let depth = 0
+	let deepest = 0
+	for (const unit of text) {
+		depth += unit === "[" || unit === "{" ? 1 : unit === "]" || unit === "}" ? -1 : 0
+		deepest = Math.max(deepest, depth)
+	}
+	if (deepest > 1000) {
+		return Result.err(malformedArtifact("canonical", [], "JSON text nested at most 1000 deep"))
+	}
 	return fromJson(parsed.value, revivers)
 }
 
