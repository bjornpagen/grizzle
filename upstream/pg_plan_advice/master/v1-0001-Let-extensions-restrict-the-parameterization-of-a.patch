 	 */
 	if (joinrel_setup_hook)
 		(*joinrel_setup_hook) (root, joinrel, outer_rel, inner_rel, sjinfo,
diff --git a/src/include/nodes/pathnodes.h b/src/include/nodes/pathnodes.h
index 2ba1dbfb..7daaf092 100644
--- a/src/include/nodes/pathnodes.h
+++ b/src/include/nodes/pathnodes.h
@@ -62,6 +62,19 @@
  * plugin can nudge the planner toward a particular strategy by disabling
  * all of the others, but that doesn't work here: unsetting PGS_SEQSCAN,
  * for instance, would disable both partial and non-partial sequential scans.
+ *
+ * A path's parameterization (the set of outer relations it requires, see
+ * PATH_REQ_OUTER) is a choice along a different axis, so it is not controlled
+ * by a bit here but by each RelOptInfo's pgs_required_outer and
+ * pgs_forbidden_outer: a path that is not parameterized by every relation in
+ * the former, or that is parameterized by any relation in the latter other
+ * than one of the rel's own lateral_relids (which every path of the rel
+ * requires), is disabled. Both are empty by default, which permits every
+ * parameterization.
+ * Unlike most of the bits above, this is enforced where paths are added to
+ * the rel (add_path and friends, and reparameterize_path), so it applies
+ * equally to paths whose costs are computed outside core, such as foreign
+ * and custom paths.
  */
 #define PGS_SEQSCAN					0x00000001
 #define PGS_INDEXSCAN				0x00000002
@@ -1040,6 +1053,10 @@ typedef struct RelOptInfo
 	bool		consider_parallel;
 	/* path generation strategy mask */
 	uint64		pgs_mask;
+	/* rels every enabled path must be parameterized by */
+	Relids		pgs_required_outer;
+	/* rels no enabled path may be parameterized by */
+	Relids		pgs_forbidden_outer;
 
