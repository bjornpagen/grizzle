{
	"$schema": "./node_modules/fallow/schema.json",
	"entry": [
		"test/**/*.test.ts",
		"test/**/*.child.ts",
		"test/types/**/fixtures/**/*.ts",
		"test/support/programs/**/*.ts",
		"test/unit/deps/fixtures/**/*.ts",
		"test/unit/deps/runtime-probe.ts",
		"test/support/pg-global-setup.ts",
		"test/types/batch/global-setup.ts",
		"vitest.config.ts",
		"vitest.network.config.ts",
		"bench/**/*.bench.ts",
		"bench/**/main.ts",
		"bench/cold/probe.ts",
		"scripts/build.ts",
		"scripts/dev/mutate/main.ts",
		"scripts/dev/mutate/vitest.config.ts",
		"scripts/dev/mutate/reporter.ts",
		"scripts/dev/mutate/oracle/*.test.ts",
		"scripts/dev/profile/compile.ts",
		"scripts/dev/profile/read.ts",
		"scripts/gen/allen/main.ts",
		"oxlint.config.ts",
		"packages/devtools/src/oxlint/fixtures.config.ts",
		"packages/testing/src/vitest/coverage.ts",
		"packages/testing/src/vitest/mutated-setup.ts",
		"packages/testing/src/witness.fixtures.ts"
	],
	"ignorePatterns": [
		"!packages/engine/src/laws/families/coverage/**",
		"!packages/engine/src/query/build/**",
		"packages/devtools/src/*/fixtures/**"
	],
	"ignoreDependencies": ["grizzle:config"],
	"resolve": {
		"conditions": ["grizzle-source"]
	},
	"boundaries": {
		"zones": [
			{
				"name": "testing",
				"patterns": ["packages/testing/**"]
			},
			{
				// The one reader of PostgreSQL's output texts (codec/read.ts), which the decode zones alone import.
				"name": "reader",
				"patterns": ["packages/engine/src/codec/read.ts"]
			},
			{
				// The engine's decode sites: a family's read, a write's returned rows and a refusal's witness, and the shell's
				// decode facade. Nothing else reaches the reader.
				"name": "decode",
				"patterns": [
					"packages/engine/src/codec/row.ts",
					"packages/engine/src/plan/decode.ts",
					"packages/engine/src/write/family/decode.ts",
					"packages/engine/src/write/program/outcome.ts"
				]
			},
			{
				// The shell's decode sites: its readers of a read's and a page's rows, which alone import the decode facade.
				"name": "adapter-decode",
				"patterns": [
					"packages/grizzle/src/adapter/page/execute.ts",
					"packages/grizzle/src/adapter/page/template.ts",
					"packages/grizzle/src/adapter/reader/execution.ts",
					"packages/grizzle/src/adapter/reader/run.ts"
				]
			},
			{
				"name": "core",
				"patterns": ["packages/engine/src/core/**"]
			},
			{
				"name": "sql",
				"patterns": ["packages/engine/src/sql/**"]
			},
			{
				"name": "allen",
				"patterns": ["packages/engine/src/allen/**"]
			},
			{
				"name": "ir",
				"patterns": ["packages/engine/src/ir/**"]
			},
			{
				"name": "scalar",
				"patterns": ["packages/engine/src/scalar/**"]
			},
			{
				"name": "logical",
				"patterns": ["packages/engine/src/logical/**"]
			},
			{
				"name": "types",
				"patterns": ["packages/engine/src/types/**"]
			},
			{
				"name": "text",
				"patterns": ["packages/engine/src/text/**"]
			},
			{
				"name": "codec",
				"patterns": ["packages/engine/src/codec/**"]
			},
			{
				"name": "schema",
				"patterns": ["packages/engine/src/schema/**"]
			},
			{
				"name": "check",
				"patterns": ["packages/engine/src/check/**"]
			},
			{
				"name": "analysis",
				"patterns": ["packages/engine/src/analysis/**"]
			},
			{
				"name": "laws",
				"patterns": ["packages/engine/src/laws/**"]
			},
			{
				"name": "query",
				"patterns": ["packages/engine/src/query/**"]
			},
			{
				"name": "lower",
				"patterns": ["packages/engine/src/lower/**"]
			},
			{
				"name": "write",
				"patterns": ["packages/engine/src/write/**"]
			},
			{
				"name": "physical",
				"patterns": ["packages/engine/src/physical/**"]
			},
			{
				"name": "program",
				"patterns": ["packages/engine/src/program/**"]
			},
			{
				"name": "deploy",
				"patterns": ["packages/engine/src/deploy/**"]
			},
			{
				"name": "public",
				"patterns": ["packages/engine/src/public/**"]
			},
			{
				"name": "plan",
				"patterns": ["packages/engine/src/plan/**"]
			},
			{
				"name": "adapter",
				"patterns": ["packages/grizzle/src/adapter/**"]
			},
			{
				"name": "cli",
				"patterns": ["packages/grizzle/src/cli/**"]
			},
			{
				"name": "engine-index",
				"patterns": ["packages/engine/src/index.ts"]
			},
			{
				"name": "index",
				"patterns": ["packages/grizzle/src/index.ts"]
			}
		],
		"rules": [
			{
				"from": "testing",
				"allow": []
			},
			{
				"from": "reader",
				"allow": ["codec", "core", "ir", "scalar"]
			},
			{
				"from": "decode",
				"allow": [
					"analysis",
					"check",
					"codec",
					"core",
					"ir",
					"laws",
					"logical",
					"lower",
					"query",
					"reader",
					"scalar",
					"schema",
					"sql",
					"types",
					"write"
				]
			},
			{
				"from": "core",
				"allow": []
			},
			{
				"from": "sql",
				"allow": ["core"]
			},
			{
				"from": "allen",
				"allow": ["core", "sql"]
			},
			{
				"from": "ir",
				"allow": ["core", "sql"]
			},
			{
				"from": "scalar",
				"allow": ["core", "ir"]
			},
			{
				"from": "logical",
				"allow": ["core", "ir", "scalar"]
			},
			{
				"from": "types",
				"allow": ["allen", "core", "ir", "scalar"]
			},
			{
				"from": "text",
				"allow": ["core", "ir", "scalar", "sql", "types"]
			},
			{
				"from": "codec",
				"allow": ["core", "ir", "scalar", "types"]
			},
			{
				"from": "schema",
				"allow": ["codec", "core", "ir", "scalar", "sql", "text", "types"]
			},
			{
				"from": "check",
				"allow": ["allen", "core", "ir", "logical", "scalar", "schema", "text"]
			},
			{
				"from": "analysis",
				"allow": ["check", "core", "ir", "logical", "scalar", "schema", "text", "types"]
			},
			{
				// The law model attaches the described public Law to each constraint it plans: Law is plain data, so naming
				// its type couples nothing at run time.
				"from": "laws",
				"allow": ["analysis", "core", "ir", "scalar", "schema", "sql"],
				"allowTypeOnly": ["types"]
			},
			{
				"from": "query",
				"allow": ["core", "ir", "scalar", "schema", "text", "types"]
			},
			{
				"from": "lower",
				"allow": ["analysis", "check", "codec", "core", "ir", "logical", "scalar", "sql"]
			},
			{
				"from": "write",
				"allow": [
					"analysis",
					"check",
					"codec",
					"core",
					"decode",
					"ir",
					"laws",
					"logical",
					"lower",
					"query",
					"scalar",
					"schema",
					"sql",
					"types"
				]
			},
			{
				"from": "physical",
				"allow": [
					"analysis",
					"check",
					"core",
					"ir",
					"laws",
					"logical",
					"lower",
					"scalar",
					"schema",
					"sql",
					"text",
					"types",
					"write"
				]
			},
			{
				"from": "program",
				"allow": [
					"analysis",
					"check",
					"codec",
					"core",
					"decode",
					"ir",
					"laws",
					"logical",
					"lower",
					"physical",
					"query",
					"schema",
					"sql",
					"types",
					"write"
				]
			},
			{
				"from": "deploy",
				"allow": ["core", "ir", "laws", "lower", "physical", "schema", "sql", "text"]
			},
			{
				"from": "public",
				"allow": ["allen", "core", "program", "query", "scalar", "schema", "text", "types", "write"]
			},
			{
				"from": "plan",
				"allow": [
					"analysis",
					"check",
					"codec",
					"core",
					"decode",
					"deploy",
					"ir",
					"lower",
					"physical",
					"program",
					"query",
					"scalar",
					"schema",
					"sql",
					"types",
					"write"
				]
			},
			{
				"from": "adapter-decode",
				"allow": [
					"adapter",
					"analysis",
					"check",
					"codec",
					"core",
					"decode",
					"deploy",
					"ir",
					"logical",
					"lower",
					"physical",
					"plan",
					"program",
					"query",
					"reader",
					"scalar",
					"schema",
					"sql",
					"types",
					"write"
				]
			},
			{
				"from": "adapter",
				"allow": [
					"adapter-decode",
					"analysis",
					"check",
					"codec",
					"core",
					"decode",
					"deploy",
					"ir",
					"logical",
					"lower",
					"physical",
					"plan",
					"program",
					"query",
					"scalar",
					"schema",
					"sql",
					"types",
					"write"
				]
			},
			{
				"from": "cli",
				"allow": [
					"adapter",
					"core",
					"deploy",
					"ir",
					"physical",
					"plan",
					"program",
					"schema",
					"sql",
					"types"
				]
			},
			{
				"from": "engine-index",
				"allow": ["public"]
			},
			{
				"from": "index",
				"allow": ["adapter", "engine-index"]
			}
		],
		"coverage": {
			"requireAllFiles": true,
			"allowUnmatched": [
				"test/**",
				"bench/**",
				"scripts/**",
				"packages/devtools/**",
				"oxlint.config.ts",
				"vitest.config.ts",
				"vitest.network.config.ts"
			]
		}
	},
	// The engine modules the plan facades re-export from (packages/engine/src/plan) share these names with other modules:
	// each facade re-exports a name explicitly from the one module it names, so no name resolves ambiguously through
	// them, and renaming same-named builders and types apart would make worse code.
	"ignoreExports": [
		{ "file": "packages/engine/src/codec/recordset.ts", "exports": ["RelationSpec"] },
		{ "file": "packages/engine/src/core/canonical.ts", "exports": ["Refusal"] },
		{
			"file": "packages/engine/src/core/decoder.ts",
			"exports": ["Column", "Delivered", "Delivery", "Layout", "Part", "columnAt"]
		},
		{
			"file": "packages/engine/src/core/errors.ts",
			"exports": ["Artifact", "GuardTest", "TransientReason", "within"]
		},
		{
			"file": "packages/engine/src/core/identity.ts",
			"exports": ["DeclaredName", "Part", "SpanCheck"]
		},
		{ "file": "packages/engine/src/core/invariant.ts", "exports": ["defined"] },
		{ "file": "packages/engine/src/core/limits.ts", "exports": ["derived"] },
		{ "file": "packages/engine/src/core/record.ts", "exports": ["isList"] },
		{ "file": "packages/engine/src/deploy/diff/plan.ts", "exports": ["Action", "Step"] },
		{ "file": "packages/engine/src/deploy/render/folder.ts", "exports": ["Spelled"] },
		{ "file": "packages/engine/src/deploy/render/generate.ts", "exports": ["DraftInput"] },
		{ "file": "packages/engine/src/ir/codes.ts", "exports": ["codecOf", "noRenames"] },
		{
			"file": "packages/engine/src/ir/desc.ts",
			"exports": ["CompareOp", "Spelled", "compareOps", "everyFact"]
		},
		{ "file": "packages/engine/src/ir/family.ts", "exports": ["Family"] },
		{ "file": "packages/engine/src/ir/law.ts", "exports": ["DomainCheck", "LawSide"] },
		{ "file": "packages/engine/src/ir/products.ts", "exports": ["StatementRole"] },
		{
			"file": "packages/engine/src/ir/rel.ts",
			"exports": [
				"AggregateFn",
				"AggregateSpec",
				"Cell",
				"Context",
				"Delivered",
				"Delta",
				"FrameBound",
				"Heading",
				"Occurrence",
				"OrderKey"
			]
		},
		{
			"file": "packages/engine/src/ir/scalar.ts",
			"exports": [
				"Capability",
				"Carrier",
				"baseOf",
				"carriers",
				"rosterOf",
				"spanCarrierOf",
				"textOf"
			]
		},
		{
			"file": "packages/engine/src/lower/conservative/context.ts",
			"exports": ["columnType", "refuse"]
		},
		{
			"file": "packages/engine/src/lower/conservative/types.ts",
			"exports": ["KeyColumn", "StatementRole"]
		},
		{ "file": "packages/engine/src/lower/shapes/index.ts", "exports": ["asDelivered"] },
		{ "file": "packages/engine/src/lower/shapes/take/index.ts", "exports": ["RelationInput"] },
		{
			"file": "packages/engine/src/physical/ddl/names.ts",
			"exports": ["ColumnType", "columnType"]
		},
		{ "file": "packages/engine/src/program/schema.ts", "exports": ["BuiltSchema"] },
		{ "file": "packages/engine/src/program/workload/value.ts", "exports": ["workload"] },
		{ "file": "packages/engine/src/scalar/values/identity.ts", "exports": ["compareValues"] },
		{
			"file": "packages/engine/src/schema/protocol.ts",
			"exports": ["PredicateValue", "predicateValue"]
		},
		{ "file": "packages/engine/src/schema/relation.ts", "exports": ["NamedRelation", "derived"] },
		{ "file": "packages/engine/src/schema/world.ts", "exports": ["loginRoleOf"] },
		{
			"file": "packages/engine/src/sql/ast.ts",
			"exports": ["Call", "FrameBound", "IndexKey", "KeyColumn"]
		},
		{
			"file": "packages/engine/src/sql/build.ts",
			"exports": [
				"and",
				"asc",
				"cast",
				"columnKey",
				"countStar",
				"cte",
				"derived",
				"eq",
				"exists",
				"gt",
				"join",
				"ne",
				"not",
				"notExists",
				"or",
				"param",
				"select",
				"setOperation"
			]
		},
		{
			"file": "packages/engine/src/sql/catalog.ts",
			"exports": [
				"and",
				"cast",
				"countStar",
				"cte",
				"eq",
				"exists",
				"gt",
				"join",
				"ne",
				"not",
				"notExists",
				"or",
				"param",
				"select"
			]
		},
		{ "file": "packages/engine/src/sql/naming.ts", "exports": ["freshNames"] },
		{
			"file": "packages/engine/src/types/changeset/changeset.ts",
			"exports": ["Delta", "LawSide", "Member", "Stratum", "Witness", "Written"]
		},
		{
			"file": "packages/engine/src/types/core/phantom.ts",
			"exports": ["Carrier", "DeclaredName", "Literal", "Refusal", "Source", "SourceOrigin", "Term"]
		},
		{ "file": "packages/engine/src/types/evidence/evidence.ts", "exports": ["Evidence"] },
		{
			"file": "packages/engine/src/types/query/query.ts",
			"exports": ["AttachedHeads", "Ordered", "Query"]
		},
		{ "file": "packages/engine/src/types/schema/statements.ts", "exports": ["Ordered", "TermOf"] },
		{ "file": "packages/engine/src/types/schema/world.ts", "exports": ["Context"] },
		{ "file": "packages/engine/src/write/changeset/value.ts", "exports": ["MemberOp"] },
		{ "file": "packages/engine/src/write/delta/net.ts", "exports": ["netStrata", "outcomeKind"] },
		{ "file": "packages/engine/src/write/family/order.ts", "exports": ["Plan"] },
		{ "file": "packages/engine/src/write/program/outcome.ts", "exports": ["keyWitness"] }
	],
	// use and useRelation: fallow does not follow union narrowing, and ParamCell's methods are called on the narrowed
	// BindValue in check/checker.ts. release: fallow does not type a for-of binding, and SessionPool.release calls
	// SessionStatements.release on each open session it iterates in adapter/wire/session.ts makePool. retype, scalar,
	// relation and member: union narrowing again, the lowering's StatementParams and WriteParams methods called on the
	// placeholders a statement's narrowed kind holds (lower/conservative/context.ts). _tag: KeyConflict's tag, read
	// through the error unions that discriminate on it. matches: fallow does not follow an interface to its classes, and
	// the evaluator calls PatternReads.matches on the CompilePatterns or ProgramPatterns its caller passes
	// (scalar/compute/evaluate.ts, a Compute.matches).
	"usedClassMembers": [
		"discriminantSpine",
		"use",
		"useRelation",
		"freshVar",
		"freshOccurrence",
		"freshScope",
		"release",
		"retype",
		"scalar",
		"relation",
		"member",
		"matches",
		"_tag"
	]
}
