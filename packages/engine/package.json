{
	"name": "@bjornpagen/grizzle-engine",
	"private": true,
	"description": "The compiler behind @bjornpagen/grizzle: turns TypeScript tables, rules, permissions and queries into PostgreSQL 19 SQL",
	"license": "0BSD",
	"author": "Bjorn Pagen <11238136+bjornpagen@users.noreply.github.com>",
	"type": "module",
	"engines": {
		"node": ">=26"
	},
	"imports": {
		"#compiler/*": "./src/*"
	},
	"exports": {
		".": "./src/index.ts",
		"./internal/plan/catalog.ts": "./src/plan/catalog.ts",
		"./internal/plan/change.ts": "./src/plan/change.ts",
		"./internal/plan/common.ts": "./src/plan/common.ts",
		"./internal/plan/decode.ts": "./src/plan/decode.ts",
		"./internal/plan/migration.ts": "./src/plan/migration.ts",
		"./internal/plan/read.ts": "./src/plan/read.ts",
		"./internal/plan/runtime.ts": "./src/plan/runtime.ts",
		"./internal/plan/serve.ts": "./src/plan/serve.ts",
		"./package.json": "./package.json"
	},
	"sideEffects": false,
	"scripts": {
		"typecheck": "effect-tsgo tsrs -b",
		"superlint": "superlint",
		"oxlint": "oxlint"
	},
	"dependencies": {
		"arkregex": "catalog:"
	},
	"devDependencies": {
		"effect": "catalog:"
	},
	"peerDependencies": {
		"effect": "^4.1.2"
	}
}
