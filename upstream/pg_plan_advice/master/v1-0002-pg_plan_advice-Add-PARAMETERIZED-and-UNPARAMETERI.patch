diff --git a/contrib/pg_plan_advice/sql/parameterized.sql b/contrib/pg_plan_advice/sql/parameterized.sql
new file mode 100644
index 00000000..8f5cc039
--- /dev/null
+++ b/contrib/pg_plan_advice/sql/parameterized.sql
@@ -0,0 +1,172 @@
+LOAD 'pg_plan_advice';
+SET max_parallel_workers_per_gather = 0;
+
+-- A small table of documents and a large table of their nodes, keyed by
+-- (doc, f1, f2), with a second index on (doc, f1).
+CREATE TABLE pz_doc (doc int PRIMARY KEY, owner int NOT NULL)
+	WITH (autovacuum_enabled = false);
+INSERT INTO pz_doc SELECT d, d % 2 FROM generate_series(1, 4) d;
+CREATE TABLE pz_node (doc int NOT NULL, f1 int NOT NULL, f2 int NOT NULL,
+	v text NOT NULL, PRIMARY KEY (doc, f1, f2))
+	WITH (autovacuum_enabled = false);
+CREATE INDEX pz_node_doc_f1 ON pz_node (doc, f1);
+INSERT INTO pz_node SELECT d, f, g, 'x'
+	FROM generate_series(1, 4) d, generate_series(1, 5) f,
+		 generate_series(1, 3000) g;
+VACUUM ANALYZE pz_doc, pz_node;
+
+-- With accurate statistics, the key of pz_node is probed once per document:
+-- its scan takes pz_doc's key as a parameter, and the generated advice says
+-- so. pz_doc could have been parameterized by pz_node, and wasn't, which the
+-- advice also says.
+EXPLAIN (COSTS OFF, PLAN_ADVICE)
+	SELECT n.v FROM pz_doc d JOIN pz_node n ON n.doc = d.doc AND n.f1 = 1
+	AND n.f2 = 2 WHERE d.owner = 1;
+
+-- Now make both tables look empty, as they do after a VACUUM that ran while
+-- the transaction filling them was still open: pages are counted, rows are
+-- not. Every index path now costs the same, and the planner's own choice
+-- leaves pz_doc's key out of the index condition.
+SELECT pg_restore_relation_stats('schemaname', 'public', 'relname', 'pz_doc',
+	'relpages', 1, 'reltuples', 0::real);
+SELECT pg_restore_relation_stats('schemaname', 'public', 'relname', 'pz_node',
+	'relpages', 100, 'reltuples', 0::real);
+SELECT pg_clear_attribute_stats('public', 'pz_doc', a, false)
+	FROM unnest(ARRAY['doc', 'owner']) a;
+SELECT pg_clear_attribute_stats('public', 'pz_node', a, false)
+	FROM unnest(ARRAY['doc', 'f1', 'f2', 'v']) a;
+EXPLAIN (COSTS OFF, PLAN_ADVICE)
+	SELECT n.v FROM pz_doc d JOIN pz_node n ON n.doc = d.doc AND n.f1 = 1
+	AND n.f2 = 2 WHERE d.owner = 1;
+
+-- Advice that pins the join order, the join method and the index, but not
+-- the parameterization, doesn't bring the probe back, because the
+-- parameterized path costs no less than the unparameterized one and is
+-- discarded before joins are planned. The advice generated from both plans
+-- used to be the same, so it could not tell them apart.
+BEGIN;
+SET LOCAL pg_plan_advice.advice = 'JOIN_ORDER(d n) NESTED_LOOP_PLAIN(n)
+	SEQ_SCAN(d) INDEX_SCAN(n public.pz_node_pkey)';
+EXPLAIN (COSTS OFF)
+	SELECT n.v FROM pz_doc d JOIN pz_node n ON n.doc = d.doc AND n.f1 = 1
+	AND n.f2 = 2 WHERE d.owner = 1;
+
+-- The advice generated from the first plan reproduces it.
+SET LOCAL pg_plan_advice.advice = 'JOIN_ORDER(d n) NESTED_LOOP_PLAIN(n)
+	SEQ_SCAN(d) INDEX_SCAN(n public.pz_node_pkey) PARAMETERIZED(n d)
+	UNPARAMETERIZED(d)';
+EXPLAIN (COSTS OFF, PLAN_ADVICE)
+	SELECT n.v FROM pz_doc d JOIN pz_node n ON n.doc = d.doc AND n.f1 = 1
+	AND n.f2 = 2 WHERE d.owner = 1;
+
+-- PARAMETERIZED alone also implies the join order and a nested loop above
+-- the parameterized scan, though not the index.
+SET LOCAL pg_plan_advice.advice = 'PARAMETERIZED(n d)';
+EXPLAIN (COSTS OFF)
+	SELECT n.v FROM pz_doc d JOIN pz_node n ON n.doc = d.doc AND n.f1 = 1
+	AND n.f2 = 2 WHERE d.owner = 1;
+
+-- UNPARAMETERIZED rules out parameterized scans of its target, whichever
+-- side of the join it is on.
+SET LOCAL pg_plan_advice.advice = 'UNPARAMETERIZED(d n)';
+EXPLAIN (COSTS OFF)
+	SELECT n.v FROM pz_doc d JOIN pz_node n ON n.doc = d.doc AND n.f1 = 1
+	AND n.f2 = 2 WHERE d.owner = 1;
+
+-- Advice that can't be applied: a source that isn't in the query, a source
+-- that is the target itself, and two items that disagree.
+SET LOCAL pg_plan_advice.advice = 'PARAMETERIZED(n nosuch)';
+EXPLAIN (COSTS OFF)
+	SELECT n.v FROM pz_doc d JOIN pz_node n ON n.doc = d.doc AND n.f1 = 1
+	AND n.f2 = 2 WHERE d.owner = 1;
+SET LOCAL pg_plan_advice.advice = 'PARAMETERIZED(n n)';
+EXPLAIN (COSTS OFF)
+	SELECT n.v FROM pz_doc d JOIN pz_node n ON n.doc = d.doc AND n.f1 = 1
+	AND n.f2 = 2 WHERE d.owner = 1;
+SET LOCAL pg_plan_advice.advice = 'PARAMETERIZED(n d) UNPARAMETERIZED(n)';
+EXPLAIN (COSTS OFF)
+	SELECT n.v FROM pz_doc d JOIN pz_node n ON n.doc = d.doc AND n.f1 = 1
+	AND n.f2 = 2 WHERE d.owner = 1;
+COMMIT;
+
+-- A star join: the fact table can take its parameters from either dimension
+-- or from both, and each is a different plan.
+CREATE TABLE pz_dim1 (id int PRIMARY KEY, a int) WITH (autovacuum_enabled = false);
+CREATE TABLE pz_dim2 (id int PRIMARY KEY, b int) WITH (autovacuum_enabled = false);
+CREATE TABLE pz_fact (d1 int, d2 int, x int) WITH (autovacuum_enabled = false);
+CREATE INDEX pz_fact_d1_d2 ON pz_fact (d1, d2);
+INSERT INTO pz_dim1 SELECT g, g % 10 FROM generate_series(1, 100) g;
+INSERT INTO pz_dim2 SELECT g, g % 10 FROM generate_series(1, 100) g;
+INSERT INTO pz_fact SELECT g % 100 + 1, g % 97 + 1, g
+	FROM generate_series(1, 100000) g;
+VACUUM ANALYZE pz_dim1, pz_dim2, pz_fact;
+EXPLAIN (COSTS OFF, PLAN_ADVICE)
+	SELECT * FROM pz_dim1 d1, pz_dim2 d2, pz_fact f
+	WHERE f.d1 = d1.id AND f.d2 = d2.id AND d1.a = 1 AND d2.b = 1;
+BEGIN;
+SET LOCAL pg_plan_advice.advice = 'JOIN_ORDER(d1 d2 f) PARAMETERIZED(f d1)';
+EXPLAIN (COSTS OFF, PLAN_ADVICE)
+	SELECT * FROM pz_dim1 d1, pz_dim2 d2, pz_fact f
+	WHERE f.d1 = d1.id AND f.d2 = d2.id AND d1.a = 1 AND d2.b = 1;
+SET LOCAL pg_plan_advice.advice = 'JOIN_ORDER(d1 d2 f) PARAMETERIZED(f (d1 d2))';
+EXPLAIN (COSTS OFF, PLAN_ADVICE)
+	SELECT * FROM pz_dim1 d1, pz_dim2 d2, pz_fact f
+	WHERE f.d1 = d1.id AND f.d2 = d2.id AND d1.a = 1 AND d2.b = 1;
+COMMIT;
+
+-- A parameter that an outer join can null makes the outer join part of the
+-- parameterization; advice never names outer joins, so this still works.
+EXPLAIN (COSTS OFF, PLAN_ADVICE)
+	SELECT * FROM pz_dim1 d1 LEFT JOIN pz_dim2 d2 ON d2.id = d1.a
+	LEFT JOIN pz_fact f ON f.d1 = d2.id AND f.d2 = d1.id
+	WHERE d1.id = 5;
+BEGIN;
+SET LOCAL pg_plan_advice.advice = 'JOIN_ORDER(d2 d1 f) MERGE_JOIN_PLAIN(d1)
+	NESTED_LOOP_PLAIN(f) SEQ_SCAN(d1) PARAMETERIZED(f d2) UNPARAMETERIZED(d2)
+	INDEX_SCAN(d2 public.pz_dim2_pkey f public.pz_fact_d1_d2)';
+EXPLAIN (COSTS OFF)
+	SELECT * FROM pz_dim1 d1 LEFT JOIN pz_dim2 d2 ON d2.id = d1.a
+	LEFT JOIN pz_fact f ON f.d1 = d2.id AND f.d2 = d1.id
+	WHERE d1.id = 5;
+SET LOCAL pg_plan_advice.advice = 'UNPARAMETERIZED(f)';
+EXPLAIN (COSTS OFF, PLAN_ADVICE)
+	SELECT * FROM pz_dim1 d1 LEFT JOIN pz_dim2 d2 ON d2.id = d1.a
+	LEFT JOIN pz_fact f ON f.d1 = d2.id AND f.d2 = d1.id
+	WHERE d1.id = 5;
+COMMIT;
+
+-- A partitioned table on the inner side: each partition's scan takes its
+-- parameters from the outer relation, and the outer relation is named the
+-- way the planner names it, by its topmost parent.
+CREATE TABLE pz_part (id int, v int) PARTITION BY RANGE (id);
+CREATE TABLE pz_part_1 PARTITION OF pz_part FOR VALUES FROM (0) TO (50000)
+	WITH (autovacuum_enabled = false);
+CREATE TABLE pz_part_2 PARTITION OF pz_part FOR VALUES FROM (50000) TO (100001)
+	WITH (autovacuum_enabled = false);
+CREATE INDEX ON pz_part (id);
+INSERT INTO pz_part SELECT g, g FROM generate_series(1, 100000) g;
+VACUUM ANALYZE pz_part;
+BEGIN;
+SET LOCAL pg_plan_advice.advice = 'JOIN_ORDER(d1 p) NESTED_LOOP_PLAIN(p)';
+EXPLAIN (COSTS OFF, PLAN_ADVICE)
+	SELECT * FROM pz_dim1 d1 JOIN pz_part p ON p.id = d1.id WHERE d1.id < 3;
+SET LOCAL pg_plan_advice.advice = 'JOIN_ORDER(d1 p) NESTED_LOOP_PLAIN(p)
+	UNPARAMETERIZED(p/public.pz_part_2)';
+EXPLAIN (COSTS OFF)
+	SELECT * FROM pz_dim1 d1 JOIN pz_part p ON p.id = d1.id WHERE d1.id < 3;
+COMMIT;
+
+-- A lateral function's scan must take parameters from the relation it
+-- refers to; that is not a choice, so no advice is generated for it.
+EXPLAIN (COSTS OFF, PLAN_ADVICE)
+	SELECT * FROM pz_dim1 d1, LATERAL generate_series(1, d1.a) g
+	WHERE d1.id < 3;
+
+-- Inside a lateral subquery that is not flattened, values from the outer
+-- query are constants of the subquery's own join problem, so the scan in the
+-- subquery is not parameterized at its level; the subquery itself is, but
+-- only by its lateral reference, which is not a choice.
+EXPLAIN (COSTS OFF, PLAN_ADVICE)
+	SELECT * FROM pz_dim1 d1, LATERAL
+	(SELECT * FROM pz_dim2 d2 WHERE d2.id = d1.a LIMIT 1) s
+	WHERE d1.id < 3;
diff --git a/contrib/pg_plan_advice/sql/syntax.sql b/contrib/pg_plan_advice/sql/syntax.sql
index 58685b93..a697053d 100644
--- a/contrib/pg_plan_advice/sql/syntax.sql
+++ b/contrib/pg_plan_advice/sql/syntax.sql
@@ -98,3 +98,20 @@ SET pg_plan_advice.advice = 'SEQ_SCAN(t/public.hash_join)';
 SET pg_plan_advice.advice = 'SEQ_SCAN(t/hash_join.foo)';
 SET pg_plan_advice.advice = 'SEQ_SCAN(t@hash_join)';
 SET pg_plan_advice.advice = 'SEQ_SCAN(t@seq_scan)';
+
+-- PARAMETERIZED pairs each target with the relation, or the parenthesized
+-- list of relations, from which it takes its parameters; UNPARAMETERIZED
+-- takes plain targets.
+SET pg_plan_advice.advice = 'PARAMETERIZED(a b c (d e#2@f))';
+EXPLAIN (COSTS OFF) SELECT 1;
+SET pg_plan_advice.advice = 'UNPARAMETERIZED(a b@c)';
+EXPLAIN (COSTS OFF) SELECT 1;
+SET pg_plan_advice.advice = 'PARAMETERIZED()';
+EXPLAIN (COSTS OFF) SELECT 1;
+SET pg_plan_advice.advice = 'PARAMETERIZED(a)';
+SET pg_plan_advice.advice = 'PARAMETERIZED(a ())';
+SET pg_plan_advice.advice = 'PARAMETERIZED(a ((b)))';
+SET pg_plan_advice.advice = 'PARAMETERIZED((a) b)';
+SET pg_plan_advice.advice = 'UNPARAMETERIZED((a))';
+SET pg_plan_advice.advice = 'SEQ_SCAN(parameterized unparameterized)';
+EXPLAIN (COSTS OFF) SELECT 1;
diff --git a/doc/src/sgml/pgplanadvice.sgml b/doc/src/sgml/pgplanadvice.sgml
index 34c3c431..afd39872 100644
--- a/doc/src/sgml/pgplanadvice.sgml
+++ b/doc/src/sgml/pgplanadvice.sgml
@@ -60,6 +60,7 @@ EXPLAIN (COSTS OFF, PLAN_ADVICE)
    JOIN_ORDER(f d)
    HASH_JOIN(d)
    SEQ_SCAN(f d)
+   UNPARAMETERIZED(f d)
    NO_GATHER(f d)
 </programlisting>
 
@@ -73,6 +74,9 @@ EXPLAIN (COSTS OFF, PLAN_ADVICE)
    <literal>d</literal> should appear on the inner side of a hash join.
    <literal>SEQ_SCAN(f d)</literal> means that both <literal>f</literal>
    and <literal>d</literal> should be accessed via a sequential scan.
+   <literal>UNPARAMETERIZED(f d)</literal> means that neither scan should
+   take parameters from the other relation, as it would if it were probed
+   once for each row of the other.
    <literal>NO_GATHER(f d)</literal> means that neither <literal>f</literal>
    nor <literal>d</literal> should appear beneath a <literal>Gather</literal>
    or <literal>Gather Merge</literal> node. For more details on the plan
@@ -432,6 +436,86 @@ join_method_name(<replaceable>join_method_item</replaceable> [ ... ])
 
   </sect3>
 
+  <sect3 id="pgplanadvice-parameterization">
+  <title>Parameterization Advice</title>
+   <synopsis>
+PARAMETERIZED(<replaceable>advice_target</replaceable> <replaceable>parameter_source</replaceable> [ ... ])
+UNPARAMETERIZED(<replaceable>advice_target</replaceable> [ ... ])
+
+<phrase>where <replaceable>parameter_source</replaceable> is:</phrase>
+
+{ <replaceable>advice_target</replaceable> |
+( <replaceable>advice_target</replaceable> [ ... ] ) }</synopsis>
+
+   <para>
+    When a relation is scanned on the inner side of a nested loop, the planner
+    can <firstterm>parameterize</firstterm> the scan by relations on the outer
+    side, so that join clauses become conditions of the scan itself, such as
+    index conditions, evaluated once for each outer row. Join order, join
+    method and scan advice do not determine whether this happens: the same
+    nested loop and index can also be used with the join clause applied as a
+    join filter instead.
+   </para>
+
+   <para>
+    <literal>PARAMETERIZED(n d)</literal> specifies that the scan of
+    <literal>n</literal> should take its parameters from exactly
+    <literal>d</literal>; <literal>PARAMETERIZED(n (d e))</literal> specifies
+    that it should take them from exactly <literal>d</literal> and
+    <literal>e</literal> together. <literal>UNPARAMETERIZED(n)</literal>
+    specifies that it should take none. For example:
+   </para>
+
+<programlisting>
+SET pg_plan_advice.advice = 'JOIN_ORDER(d n) NESTED_LOOP_PLAIN(n)
+    INDEX_SCAN(n node_pkey) PARAMETERIZED(n d)';
+EXPLAIN (COSTS OFF)
+    SELECT n.v FROM doc d JOIN node n ON n.doc = d.doc AND n.f1 = 1
+    WHERE d.owner = 1;
+                    QUERY PLAN
+--------------------------------------------------
+ Nested Loop
+   ->  Seq Scan on doc d
+         Filter: (owner = 1)
+   ->  Index Scan using node_pkey on node n
+         Index Cond: ((doc = d.doc) AND (f1 = 1))
+ Supplied Plan Advice:
+   INDEX_SCAN(n node_pkey) /* matched */
+   PARAMETERIZED(n d) /* matched */
+   JOIN_ORDER(d n) /* matched */
+   NESTED_LOOP_PLAIN(n) /* matched */
+</programlisting>
+
+   <para>
+    Without <literal>PARAMETERIZED(n d)</literal>, the same join order, join
+    method and index could instead produce
+    <literal>Join Filter: (d.doc = n.doc)</literal> with only
+    <literal>(f1 = 1)</literal> as the index condition, and the planner may
+    choose that plan whenever the statistics make the two look equally
+    cheap, for instance when a table's statistics say it is empty.
+   </para>
+
+   <para>
+    Relations that supply parameters are named by their topmost parent: a
+    partition's scan parameterized by a partitioned table is advised as
+    <literal>PARAMETERIZED(n/public.n_p1 d)</literal>, even when, in a
+    partitionwise join, the value comes from one of <literal>d</literal>'s
+    partitions. A relation that a lateral reference requires is part of every
+    parameterization of the scan, so it is neither required nor ruled out by
+    this advice. As with join method advice, parameterization advice implies
+    a join order: the relations named as sources must be joined before the
+    target.
+   </para>
+
+   <para>
+    Generated advice includes this advice for each relation scanned by
+    itself for which the planner had a choice of parameterization, except
+    a scan that takes a computed value, such as the output of a subquery
+    expression, as a parameter.
+   </para>
+
+  </sect3>
+
