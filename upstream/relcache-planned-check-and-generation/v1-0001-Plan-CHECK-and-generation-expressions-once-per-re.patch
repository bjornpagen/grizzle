 /*
diff --git a/src/test/regress/expected/relcache_exprs.out b/src/test/regress/expected/relcache_exprs.out
new file mode 100644
index 0000000..46d1bea
--- /dev/null
+++ b/src/test/regress/expected/relcache_exprs.out
@@ -0,0 +1,461 @@
+--
+-- CHECK constraint and generation expressions are planned once per relcache
+-- entry, not once per statement.  The results must be as if they were still
+-- planned each time.
+--
+-- Zero-argument IMMUTABLE constants, read one bit at a time
+CREATE FUNCTION relexpr_bits() RETURNS bit varying
+  LANGUAGE sql IMMUTABLE PARALLEL SAFE RETURN B'0110';
+CREATE FUNCTION relexpr_bits2() RETURNS bit varying
+  LANGUAGE sql IMMUTABLE PARALLEL SAFE RETURN B'1001';
+--
+-- CHECK constraints, before and after ADD and DROP CONSTRAINT
+--
