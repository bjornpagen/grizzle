+/*
+ * Assign hook for pg_plan_advice.advice
+ *
+ * Count every assignment, so that a cached plan made under the advice in
+ * force at one assignment can be reused at the next without comparing the
+ * strings. Re-setting the same string, as a function's SET clause does on
+ * each call, costs a single string comparison and never forces a replan.
+ */
+static void
+pg_plan_advice_advice_assign_hook(const char *newval, void *extra)
+{
+	pgpa_advice_guc_generation++;
+}
+
+/*
+ * Hook to decide whether a cached generic plan may be reused.
+ *
+ * A generic plan is reused only while the advice that would be supplied now
+ * for each of its statements is the advice it was planned under, whether
+ * that advice comes from pg_plan_advice.advice or from an advisor. Otherwise
+ * a plan cached by one transaction would go on serving later transactions
+ * under whatever advice was in force when it was made: for example, the
+ * queries ri_triggers.c prepares for each foreign key are kept for the life
+ * of the backend.
+ */
+static bool
+pg_plan_advice_check_cached_plan(CachedPlanSource *plansource,
+								 CachedPlan *plan)
+{
+	ListCell   *lc_stmt;
+	ListCell   *lc_query;
+
+	if (prev_check_cached_plan &&
+		!(*prev_check_cached_plan) (plansource, plan))
+		return false;
+
+	forboth(lc_stmt, plan->stmt_list, lc_query, plansource->query_list)
+	{
+		PlannedStmt *pstmt = lfirst_node(PlannedStmt, lc_stmt);
+		Query	   *query = lfirst_node(Query, lc_query);
+
+		if (pstmt->commandType == CMD_UTILITY)
+			continue;
+		if (!pgpa_supplied_advice_unchanged(pstmt, query, plansource))
+			return false;
+	}
+
+	return true;
+}
+
+/*
+ * Is the advice that would be supplied for this statement now the advice
+ * that its plan was made under?
+ *
+ * Each source of advice is checked the way it actually changes. If the
+ * advisors' generations haven't moved, no advisor's answer can have changed:
+ * advice that came from an advisor is therefore still current, and advice
+ * that came from pg_plan_advice.advice needs only to be compared with that
+ * setting, which takes a single integer comparison if it hasn't been assigned
+ * since. Only when an advisor's generation has moved, or an advisor has no
+ * generation, do we work out the advice from scratch. When the advice turns
+ * out to be unchanged, we update the plan's record of the generations, so
+ * that the work is done once per change rather than once per reuse.
+ */
+static bool
+pgpa_supplied_advice_unchanged(PlannedStmt *pstmt, Query *query,
+							   CachedPlanSource *plansource)
+{
+	DefElem    *pgpa_item;
+	List	   *items;
+	DefElem    *advice_item;
+	DefElem    *by_advisor_item;
+	DefElem    *advisor_generation_item;
+	DefElem    *guc_generation_item;
+	const char *planned_advice;
+	uint64		advisor_generation;
+	pgpa_supplied_advice supplied = {0};
+	MemoryContext oldcontext;
+	bool		result;
+
+	pgpa_item = find_defelem_by_defname(pstmt->extension_state,
+										"pg_plan_advice");
+	items = pgpa_item == NULL ? NIL : (List *) pgpa_item->arg;
+	advice_item = find_defelem_by_defname(items, "supplied_advice");
+	by_advisor_item = find_defelem_by_defname(items, "supplied_by_advisor");
+	advisor_generation_item = find_defelem_by_defname(items,
+													  "advisor_generation");
+	guc_generation_item = find_defelem_by_defname(items, "guc_generation");
+	planned_advice = advice_item == NULL ? NULL : strVal(advice_item->arg);
+
+	/*
+	 * A plan made before pg_plan_advice was loaded has no record; it was
+	 * planned without advice, but we can't take any shortcut.
+	 */
+	if (guc_generation_item != NULL &&
+		pgpa_advisor_generation(&advisor_generation) &&
+		DatumGetUInt64(castNode(Const, advisor_generation_item->arg)->constvalue) ==
+		advisor_generation)
+	{
+		Const	   *guc_generation = castNode(Const, guc_generation_item->arg);
+
+		if (boolVal(by_advisor_item->arg))
+			return true;
+		if (DatumGetUInt64(guc_generation->constvalue) ==
+			pgpa_advice_guc_generation)
+			return true;
+		if (!pgpa_advice_strings_equal(planned_advice, pg_plan_advice_advice))
+			return false;
+		guc_generation->constvalue = UInt64GetDatum(pgpa_advice_guc_generation);
+		return true;
+	}
+
+	/* Work out the advice from scratch, in a short-lived context. */
+	if (pgpa_revalidation_context == NULL)
+		pgpa_revalidation_context =
+			AllocSetContextCreate(pg_plan_advice_get_mcxt(),
+								  "pg_plan_advice revalidation",
+								  ALLOCSET_SMALL_SIZES);
+	oldcontext = MemoryContextSwitchTo(pgpa_revalidation_context);
+	pg_plan_advice_get_supplied_query_advice(NULL, query,
+											 plansource->query_string,
+											 plansource->cursor_options,
+											 NULL, &supplied);
+	result = pgpa_advice_strings_equal(planned_advice, supplied.advice);
+	MemoryContextSwitchTo(oldcontext);
+
+	if (result && guc_generation_item != NULL)
+	{
+		castNode(Const, advisor_generation_item->arg)->constvalue =
+			UInt64GetDatum(supplied.advisors_have_generation ?
+						   supplied.advisor_generation : 0);
+		castNode(Const, guc_generation_item->arg)->constvalue =
+			UInt64GetDatum(supplied.guc_generation);
+		castNode(Boolean, by_advisor_item->arg)->boolval =
+			supplied.from_advisor;
+	}
+	MemoryContextReset(pgpa_revalidation_context);
+
+	return result;
+}
+
+/*
+ * Compare two advice strings, treating NULL and the empty string alike.
+ */
+static bool
+pgpa_advice_strings_equal(const char *a, const char *b)
+{
+	if (a == NULL)
+		a = "";
+	if (b == NULL)
+		b = "";
+	return strcmp(a, b) == 0;
+}
