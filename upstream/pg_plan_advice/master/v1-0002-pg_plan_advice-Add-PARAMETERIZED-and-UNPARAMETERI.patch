+pgpa_walker_scan_param_relids(pgpa_plan_walker_context *walker,
+							  pgpa_identifier *rt_identifiers, Index rti)
+{
+	pgpa_scan  *scan = walker->scan_by_rti[rti - 1];
+	pgpa_identifier *rid = &rt_identifiers[rti - 1];
+	Bitmapset  *result = NULL;
+	int			source = -1;
+
+	if (scan == NULL)
+		return NULL;
+
+	while ((source = bms_next_member(scan->param_relids, source)) >= 0)
+	{
+		pgpa_identifier *source_rid = &rt_identifiers[source - 1];
+
+		if (source_rid->alias_name != NULL &&
+			strings_equal_or_both_null(source_rid->plan_name,
+									   rid->plan_name))
+			result = bms_add_member(result, source);
+	}
+
+	return result;
