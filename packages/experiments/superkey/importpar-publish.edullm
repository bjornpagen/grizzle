/**
 * IMPORTPAR's local publish: edullm's `publishQti` (src/local-postgres/qti-publish.ts) with its S3 upload left out,
 * against a local cluster. It reads the package once (`readPackage`), refuses an absent or unlisted referenced file as
 * publishQti's `mediaOf` does, then runs the same `publishPackage` (importRowsOf, then the publisher login's
 * `publish.once`) over a verify-full TLS connection to localhost. It prints one JSON line with the wall times.
 *
 * Usage: node scripts/importpar-publish.ts <package dir> <name>
 * Environment: IMPORTPAR_PORT, IMPORTPAR_CA (the cluster's CA file), IMPORTPAR_SECRETS (a directory holding <role> password files).
 */
import { readFileSync } from "node:fs"
import net from "node:net"
import type { DbConnection } from "@bjornpagen/grizzle/runtime"
import { policy } from "@edullm/qti-database/policy"
import { publisherDbLayer, publishPackage } from "@edullm/qti-database/publication"
import { NodeRuntime, NodeServices } from "@effect/platform-node"
import { readPackage } from "@qti-pie/pantry/import/read.ts"
import { refusalOf } from "@qti-pie/pantry/import/refusal.ts"
import { Array as Arr, Console, Effect, Option, Path, Record as Rec, Redacted, String as Str } from "effect"
import pg from "pg"

const required = (name: string): string => {
	const value = process.env[name]
	if (value === undefined || value === "") {
		throw new Error(`${name} is unset`)
	}
	return value
}

const port = Number(required("IMPORTPAR_PORT"))
const ca = readFileSync(required("IMPORTPAR_CA"), "utf8")
const secrets = required("IMPORTPAR_SECRETS")

const connectionAs = (role: string): DbConnection => ({
	driver: pg,
	transport: {
		kind: "sslRequest",
		host: "localhost",
		port,
		open: () => new net.Socket(),
		ca,
		servername: "localhost"
	},
	database: "qti",
	password: Effect.sync(() => Redacted.make(readFileSync(`${secrets}/${role}`, "utf8").trim())),
	connectTimeoutMs: 10_000
})

const [dir, name] = process.argv.slice(2)
if (dir === undefined || name === undefined) {
	throw new Error("usage: importpar-publish.ts <package dir> <name>")
}

const program = Effect.gen(function* () {
	const paths = yield* Path.Path
	const at0 = Date.now()
	const t0 = performance.now()
	const pkg = yield* readPackage(dir, name)
	const t1 = performance.now()
	const documents = new Set(Arr.map(pkg.documents, (document) => document.path))
	const media = Arr.filter(Arr.fromIterable(pkg.referenced), (path) => !documents.has(path))
	const refused = Arr.filter(
		media,
		(path) =>
			pkg.files.get(path) === undefined ||
			Option.isNone(Rec.get(policy.media, Str.slice(1)(paths.extname(path))))
	)
	if (refused.length > 0) {
		return yield* Effect.die(new Error(`MediaRefused: ${refused.join(", ")}`))
	}
	const { package: published, outcome } = yield* publishPackage(pkg).pipe(
		Effect.catchIf(
			(error) => "kind" in error && error.kind === "refused",
			(error) => refusalOf(error.refused, error.witness)
		)
	)
	const t2 = performance.now()
	const at2 = Date.now()
	yield* Console.log(
		JSON.stringify({
			name,
			package: published,
			outcome: outcome.kind,
			media: media.length,
			readMs: Math.round(t1 - t0),
			publishMs: Math.round(t2 - t1),
			totalMs: Math.round(t2 - t0),
			startEpochMs: at0,
			publishStartEpochMs: at0 + Math.round(t1 - t0),
			endEpochMs: at2
		})
	)
})

NodeRuntime.runMain(program.pipe(Effect.provide([publisherDbLayer(connectionAs), NodeServices.layer])))
