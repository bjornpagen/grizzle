{
	"name": "@bjornpagen/grizzle-engine",
	"version": "1.0.0-beta.1",
	"description": "The compiler behind @bjornpagen/grizzle: turns TypeScript tables, rules, permissions and queries into PostgreSQL 19 SQL",
	"keywords": [
		"postgresql",
		"postgres",
		"typescript",
		"effect",
		"database",
		"sql",
		"compiler",
		"schema",
		"migrations",
		"query",
		"type-safe",
		"constraints",
		"row-level-security",
		"serializable"
	],
	"homepage": "https://github.com/bjornpagen/grizzle#readme",
	"bugs": {
		"url": "https://github.com/bjornpagen/grizzle/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bjornpagen/grizzle.git",
		"directory": "packages/engine"
	},
	"license": "0BSD",
	"author": "Bjorn Pagen <11238136+bjornpagen@users.noreply.github.com>",
	"type": "module",
	"engines": {
		"node": ">=26"
	},
	"imports": {
		"#compiler/*": "./src/*"
	},
	"exports": {
		".": {
			"grizzle-source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./internal/plan/catalog.ts": {
			"grizzle-source": "./src/plan/catalog.ts",
			"types": "./dist/plan/catalog.d.ts",
			"default": "./dist/plan/catalog.js"
		},
		"./internal/plan/change.ts": {
			"grizzle-source": "./src/plan/change.ts",
			"types": "./dist/plan/change.d.ts",
			"default": "./dist/plan/change.js"
		},
		"./internal/plan/common.ts": {
			"grizzle-source": "./src/plan/common.ts",
			"types": "./dist/plan/common.d.ts",
			"default": "./dist/plan/common.js"
		},
		"./internal/plan/decode.ts": {
			"grizzle-source": "./src/plan/decode.ts",
			"types": "./dist/plan/decode.d.ts",
			"default": "./dist/plan/decode.js"
		},
		"./internal/plan/migration.ts": {
			"grizzle-source": "./src/plan/migration.ts",
			"types": "./dist/plan/migration.d.ts",
			"default": "./dist/plan/migration.js"
		},
		"./internal/plan/read.ts": {
			"grizzle-source": "./src/plan/read.ts",
			"types": "./dist/plan/read.d.ts",
			"default": "./dist/plan/read.js"
		},
		"./internal/plan/runtime.ts": {
			"grizzle-source": "./src/plan/runtime.ts",
			"types": "./dist/plan/runtime.d.ts",
			"default": "./dist/plan/runtime.js"
		},
		"./internal/plan/serve.ts": {
			"grizzle-source": "./src/plan/serve.ts",
			"types": "./dist/plan/serve.d.ts",
			"default": "./dist/plan/serve.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"src"
	],
	"sideEffects": false,
	"scripts": {
		"prepack": "node --conditions=grizzle-source ../../scripts/build.ts",
		"typecheck": "effect-tsgo tsrs -b",
		"superlint": "superlint",
		"oxlint": "oxlint"
	},
	"dependencies": {
		"arkregex": "catalog:"
	},
	"devDependencies": {
		"effect": "catalog:"
	},
	"peerDependencies": {
		"effect": "^4.1.2"
	},
	"publishConfig": {
		"access": "public",
		"tag": "beta"
	}
}
